local _killDesyncActive = false
local _killDesyncConn = nil
local _killDesyncRestoreName = "AntiRivalKillDesyncRestore"
local FAR_DISTANCE = 50000000

local function countAliveEnemies()
    local count = 0
    pcall(function()
        local LP = Players.LocalPlayer
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                -- AntiEnhancement식 팀 판정 (팀전이면 아군 제외)
                local sameTeam = false
                if LP:GetAttribute("TeamID") and plr:GetAttribute("TeamID") then
                    sameTeam = (LP:GetAttribute("TeamID") == plr:GetAttribute("TeamID"))
                elseif LP.Team and plr.Team then
                    sameTeam = (LP.Team == plr.Team)
                end
                if not sameTeam then
                    local char = plr.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        count = count + 1
                    end
                end
            end
        end
    end)
    return count
end

local function StopKillDesync()
    _killDesyncActive = false
    if _killDesyncConn then
        pcall(function() _killDesyncConn:Disconnect() end)
        _killDesyncConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep(_killDesyncRestoreName)
    end)
end

local function StartKillDesync()
    if countAliveEnemies() > 0 then return end
    if _killDesyncActive then return end
    if not S.ragebotOn then return end
    _killDesyncActive = true
    local LP = LocalPlayer
    local lastFarTp = 0
    local localAnchorCF = nil
    local function getRoot()
        local char = LP.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end
    print("[Anti-rival] Ragebot: all enemies dead → strong far desync TP")
    _killDesyncConn = RunService.Heartbeat:Connect(function()
        if not _killDesyncActive then return end
        if countAliveEnemies() > 0 then StopKillDesync(); return end
        if not S.ragebotOn then StopKillDesync(); return end
        local r = getRoot()
        if not r then return end
        if not localAnchorCF then localAnchorCF = r.CFrame end
        local now = os.clock()
        if now - lastFarTp >= 3 then
            lastFarTp = now
            local ang = math.random() * math.pi * 2
            local far = Vector3.new(
                math.cos(ang) * 500000 + math.random(-2000, 2000),
                150000 + math.random(-5000, 5000),
                math.sin(ang) * 500000 + math.random(-2000, 2000)
            )
            env._killDesyncFarPos = far
        end
        local farPos = env._killDesyncFarPos or (r.Position + Vector3.new(500000, 150000, 0))
        r.CFrame = CFrame.new(farPos + Vector3.new(math.random(-120, 120), math.random(-40, 40), math.random(-120, 120)))
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
        RunService:BindToRenderStep(_killDesyncRestoreName, Enum.RenderPriority.Camera.Value - 1, function()
            local r2 = getRoot()
            if r2 and localAnchorCF then
                r2.CFrame = localAnchorCF
                r2.AssemblyLinearVelocity = Vector3.zero
                r2.AssemblyAngularVelocity = Vector3.zero
            end
            pcall(function() RunService:UnbindFromRenderStep(_killDesyncRestoreName) end)
        end)
    end)
end

