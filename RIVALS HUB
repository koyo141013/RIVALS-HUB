local function saTarget2()
    local cfgHit = S.silentAimHitPart or "Head"
    local radius = tonumber(S.silentAimFOV) or 300
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    if not CollectionService then return nil end
    local center = cam.ViewportSize / 2
    local bestPart, bestDist = nil, radius
    local ok, entities = pcall(function() return CollectionService:GetTagged("Entity") end)
    if not ok or type(entities) ~= "table" then return nil end
    for _, entity in pairs(entities) do
        if entity ~= LocalPlayer.Character then
            local hum = entity:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health > 0 then
                local cands = {}
                if cfgHit == "Head" or cfgHit == "Both" then
                    table.insert(cands, entity:FindFirstChild("Head", true))
                end
                if cfgHit == "Body" or cfgHit == "Both" then
                    table.insert(cands, entity:FindFirstChild("HumanoidRootPart", true))
                    table.insert(cands, entity:FindFirstChild("UpperTorso", true))
                end
                for _, part in ipairs(cands) do
                    if part and part:IsA("BasePart") then
                        local ok2, sp, onScreen = pcall(function()
                            return cam:WorldToViewportPoint(part.Position)
                        end)
                        if ok2 and onScreen then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d < bestDist then bestDist, bestPart = d, part end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

local function saCFD(origin, part)
    if not _saU then return nil end
    local ok, d = pcall(function()
        local cf = part.CFrame
        local dd = {}
        dd[utf8.char(1)] = {
            [utf8.char(0)] = _saU:EncodeCFrame(CFrame.lookAt(origin, part.Position)),
            [utf8.char(1)] = _saU:EncodeCFrame(cf),
            [utf8.char(2)] = part,
            [utf8.char(3)] = _saU:EncodeCFrame(cf:ToObjectSpace(CFrame.new(part.Position))),
        }
        return dd
    end)
    if ok then return d end
    return nil
end

env._installSilentNew = function()
    if env._silentNewReady then return true end
    pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
