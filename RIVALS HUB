    if not GunModule or not UtilityModule then warn("[Anti-rival] Ragebot modules not found"); return false end
    local CharHelper = setmetatable({}, {
        __index = function(_, key)
            local char = _LP.Character
            if not char then return nil end
            if key == "__root" then return char:FindFirstChild("HumanoidRootPart")
            elseif key == "__head" then return char:FindFirstChild("Head") end
            return nil
        end
    })
    genv.__s9t0u1 = {}
    local Controller = genv.__s9t0u1
    local killConns = {}
    local tracked = {}
    local function onEnemyDied()
        if not Controller.__active then return end
        task.defer(function() task.wait(0.15); StartKillDesync() end)
    end
    local function trackPlayer(plr)
        if plr == _LP then return end
        local function hookChar(char)
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and not tracked[hum] then
                tracked[hum] = true
                table.insert(killConns, hum.Died:Connect(onEnemyDied))
                table.insert(killConns, hum.HealthChanged:Connect(function(hp) if hp <= 0 then onEnemyDied() end end))
            end
        end
        if plr.Character then hookChar(plr.Character) end
        table.insert(killConns, plr.CharacterAdded:Connect(hookChar))
    end
    for _, plr in ipairs(_Players:GetPlayers()) do trackPlayer(plr) end
    table.insert(killConns, _Players.PlayerAdded:Connect(trackPlayer))
    function Controller:__init()
        self.__active = true
        self.__target = nil
        self.__desync = false
        self.__conn1 = nil
        self.__conn2 = nil
        self.__task1 = nil
        self.__oldfunc = nil
        self:__setup()
    end
    function Controller:__setup()
        self.__conn1 = _RunService.Heartbeat:Connect(function()
            if not self.__active then return end
            self.__target = self:__find()
        end)
        local originalShoot = GunModule.StartShooting
        self.__oldfunc = originalShoot
        regRestore(function()
            pcall(function()
                local g = getgenv().__s9t0u1
                if g and g.__oldfunc then GunModule.StartShooting = g.__oldfunc end
            end)
        end)
        GunModule.StartShooting = function(gun, ...)
            local results = {originalShoot(gun, ...)}
            if not gun.ClientFighter or not gun.ClientFighter.IsLocalPlayer then return unpack(results) end
            local data = results[3]
            if not data or typeof(data) ~= "table" then return unpack(results) end
            results[4] = true
            -- 무기 선택창이 열려 있으면 가공 없이 통과 (선택 중 desync 난사 방지)
            if IsPickWeaponsOpen and IsPickWeaponsOpen() then
                return unpack(results)
            end
            local target = self.__target
            if not self.__active or not target or not target.Character then return unpack(results) end
            if not self.__desync or self.__curr ~= target then
                self:__desync_start(target)
                local stab = tonumber(env._ragebotStability) or tonumber(S.ragebotStability) or 0.15
                task.wait(math.clamp(stab, 0.01, 1))
            end
            if self.__task1 then task.cancel(self.__task1); self.__task1 = nil end
            -- 리졸버 ON이면 방패/카타나 정면은 가공 없이 통과 (탄 낭비 방지)
            if S.ragebotResolver and target.Character and not ResolveShotSafe(target.Character) then
                return unpack(results)
            end
            -- HitboxHead 우선 (서버 히트박스 기준, 명중률 향상) + 중심 정조준
            local head = target.Character:FindFirstChild("HitboxHead")
                or target.Character:FindFirstChild("Head")
            if not head then return unpack(results) end
            local headPos = head.Position
            local headCF = head.CFrame
            local offset = headCF:ToObjectSpace(CFrame.new(headPos))
            data[utf8.char(0)] = UtilityModule:EncodeCFrame(CFrame.new(headPos, headPos + head.CFrame.LookVector))
            data[utf8.char(1)] = UtilityModule:EncodeCFrame(CFrame.new(headPos))
            data[utf8.char(2)] = head
            data[utf8.char(3)] = UtilityModule:EncodeCFrame(offset)
            local frames = tonumber(env._ragebotShootFrames) or tonumber(S.ragebotShootFrames) or 1
            self.__task1 = task.delay(0.05 * math.clamp(frames, 1, 10), function() self:__desync_stop() end)
            RAGE_D.shots += 1
            env._rageShots = RAGE_D.shots
            env._rageStage = "Fired"
            pcall(_rageStatusTick, false)
            return unpack(results)
        end
    end
    function Controller:__find()
        local myChar = _LP.Character
        if not myChar then return nil end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local closest, closestDist = nil, math.huge
        local MAX_DISTANCE = 200
        for _, plr in ipairs(_Players:GetPlayers()) do
            if plr == _LP then continue end
            if plr:GetAttribute("TeamID") == _LP:GetAttribute("TeamID") then continue end
            local char = plr.Character
            if not char then continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if not (root and head and hum and hum.Health > 0) then continue end
            local dist = (myRoot.Position - root.Position).Magnitude
            if dist > MAX_DISTANCE then continue end
            if dist < closestDist then closestDist = dist; closest = plr end
        end
        if self.__counted ~= closest then
            self.__counted = closest
            if closest then
                RAGE_D.targets += 1
                env._rageTargets = RAGE_D.targets
            end
        end
        return closest
    end
    function Controller:__desync_start(target)
        if self.__conn2 then self.__conn2:Disconnect() end
        self.__desync = true
        self.__curr = target
        self.__conn2 = _RunService.Heartbeat:Connect(function()
            if not self.__desync then return end
            local root = CharHelper.__root
            if not root then return end
            local enemyHead = target.Character and target.Character:FindFirstChild("Head")
            if not enemyHead then self:__desync_stop(); return end
            local savedCF = root.CFrame
            local savedVel = root.Velocity
            local savedRot = root.RotVelocity
            root.CFrame = enemyHead.CFrame
            RunService:BindToRenderStep("__restore", 101, function()
                root.CFrame = savedCF
                root.Velocity = savedVel
                root.RotVelocity = savedRot
                RunService:UnbindFromRenderStep("__restore")
            end)
        end)
    end
    function Controller:__desync_stop()
        self.__desync = false
        self.__curr = nil
        if self.__conn2 then self.__conn2:Disconnect(); self.__conn2 = nil end
    end
    function Controller:Shutdown()
        self.__active = false
        if self.__conn1 then self.__conn1:Disconnect() end
        if self.__conn2 then self.__conn2:Disconnect() end
        if self.__task1 then task.cancel(self.__task1) end
        if self.__oldfunc then GunModule.StartShooting = self.__oldfunc end
        for _, c in ipairs(killConns) do pcall(function() c:Disconnect() end) end
        killConns = {}
        tracked = {}
        StopKillDesync()
    end
    Controller:__init()
    print("[Anti-rival] User Desync Ragebot STARTED")
    env._rageStage = "Controller"
    pcall(_rageStatusTick, true)
    return true
end

local function StopUserRagebot()
    local g = getgenv()
    if g and g.__s9t0u1 then pcall(function() g.__s9t0u1:Shutdown() end); g.__s9t0u1 = nil end
    StopKillDesync()
    env._rageStage = "Off"
    pcall(_rageStatusTick, true)
    print("[Anti-rival] User Desync Ragebot STOPPED")
end

env._riv_startRagebot = function(on)
    if on then return StartUserRagebot() else StopUserRagebot() end
end

-- ============ Device Spoof Module ============
local _deviceMap = {
    Computer = "MouseKeyboard",
    Mobile = "Touch",
    Console = "Gamepad",
    VR = "VR",
}

local function ApplyDeviceSpoof(val)
    if not val or val == "None" then
        print("[DeviceSpoof] None selected — nothing sent")
        return
    end
    local control = _deviceMap[val]
    if not control then
        warn("[DeviceSpoof] Unknown device:", val)
        return
    end
    local ok, err = pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local remotes = RS:FindFirstChild("Remotes")
            or RS:FindFirstChild("Remote")
            or RS:FindFirstChild("Remotes_")
        if not remotes then error("Remotes folder not found in ReplicatedStorage") end
        local replication = remotes:FindFirstChild("Replication")
        if not replication then error("Replication not found") end
        local fighter = replication:FindFirstChild("Fighter")
        if not fighter then error("Fighter not found") end
        local setControls = fighter:FindFirstChild("SetControls")
            or fighter:FindFirstChild("SetControl")
        if not setControls then error("SetControls not found in Fighter") end
        setControls:FireServer(control)
    end)
    if ok then
        print("[DeviceSpoof] Applied:", val, "→", control)
    else
        warn("[DeviceSpoof] Failed:", err)
    end
end

