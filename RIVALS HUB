                    local pts = { hp + Vector2.new(0, -r), hp + Vector2.new(r, 0), hp + Vector2.new(0, r), hp + Vector2.new(-r, 0) }
                    for i = 1, 4 do
                        local ln = o.headDiamond[i]
                        if ln then
                            ln.Visible = true; ln.From = pts[i]; ln.To = pts[(i % 4) + 1]; ln.Color = color
                            pcall(function() ln.Thickness = Config.ESP.HeadMarkerOutline and 2 or 1 end)
