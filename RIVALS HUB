local _DS_Current = "Computer"
local DSBox = Tabs.Spoof:AddGroupbox({ Side = "Right", Name = "Device Spoof", IconName = "smartphone" })
DSBox:AddDropdown("RIV_Device", {
    Values = { "Computer", "Mobile", "Console", "VR" },
    Default = "Computer",
    Multi = false,
    Text = "Device",
    Callback = function(v) _DS_Current = v end,
})
DSBox:AddButton({
    Text = "Apply Spoof",
    Func = function()
        local function setStatus(t) pcall(function() Options.RIV_DSStatus:SetText(t) end) end
        local control = _deviceMap[_DS_Current]
        if not control then setStatus(T("장치: 오류 — 알 수 없는 기기", "Device: error — unknown device")) return end
        local ok, err = pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local remotes = RS:FindFirstChild("Remotes") or RS:FindFirstChild("Remote")
            if not remotes then error("Remotes folder not found") end
            local replication = remotes:FindFirstChild("Replication")
            if not replication then error("Replication not found") end
