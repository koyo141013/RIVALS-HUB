function _playerHoldingKatana(plr)
    if not plr or not plr.Character then return false end
    local c = plr.Character
    -- 1) 캐릭터 내 Tool (구 방식)
    local tool = c:FindFirstChildOfClass("Tool")
    if tool and string.find(string.lower(tool.Name), "katana", 1, true) then return true end
    -- 2) 뷰모델 ("플레이어명 - 무기명" 모델, Rivals 실제 장착 경로): 1.5초 캐시로 스캔 1회로
    local now = os.clock()
    local KC = env._katCache
    if not KC or now - (KC.t or 0) > 1.5 then
        KC = { t = now, set = {} }
        pcall(function()
            local vms = Workspace:FindFirstChild("ViewModels")
            if vms then
                for _, m in ipairs(vms:GetDescendants()) do
                    if m:IsA("Model") and string.find(string.lower(m.Name), "katana", 1, true) then
                        local owner = string.match(m.Name, "^(.-) %- ")
                        if owner then KC.set[owner] = true end
                    end
                end
            end
        end)
        env._katCache = KC
    end
    return KC.set[plr.Name] == true
end

-- 팀 체크 (saGetTarget보다 먼저 정의: TeamID 우선, Team 폴백)
local function saIsTeammate(plr)
    if plr == LocalPlayer then return true end
    local skip = false
    pcall(function()
        local pt = plr:GetAttribute("TeamID")
        local lt = LocalPlayer:GetAttribute("TeamID")
        if pt ~= nil and lt ~= nil then
            skip = (pt == lt)
        elseif LocalPlayer.Team and plr.Team then
            skip = (LocalPlayer.Team == plr.Team)
        end
    end)
    return skip
end

local function saGetTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil, nil end
    local fov = tonumber(S.silentAimFOV) or 350
    local mouseLoc = UserInputService:GetMouseLocation()
    local center = Vector2.new(mouseLoc.X, mouseLoc.Y)
    local bestChar, bestPart, bestDist = nil, nil, fov
    local prefer = S.silentAimHitPart or "Head"
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character
            and not (Config.Aimbot.TeamCheck and saIsTeammate(plr)) then
            if not (S.antiKatanaOn and _playerHoldingKatana(plr)) then
                local char = plr.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = nil
                    if prefer == "Body" then
                        part = char:FindFirstChild("HitboxBody")
                            or char:FindFirstChild("UpperTorso")
                            or char:FindFirstChild("HumanoidRootPart")
                            or char:FindFirstChild("HitboxHead")
                            or char:FindFirstChild("Head")
                    else
                        part = char:FindFirstChild("HitboxHead")
                            or char:FindFirstChild("Head")
                            or char:FindFirstChild("HitboxBody")
                            or char:FindFirstChild("HumanoidRootPart")
                    end
                    if part then
                        local ok, pos, vis = pcall(function()
                            return cam:WorldToViewportPoint(part.Position)
                        end)
                        if ok and vis then
                            local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if d < bestDist then
                                bestDist = d
                                bestChar = char
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
    end
    SA_H.part = bestPart
    env._silentAimTarget = bestPart
    return bestChar, bestPart
end

