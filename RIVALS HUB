            c.Thickness = 1
            c.Filled = false
            return c
        end)
        if okC and circ then
            env._silentFOVCircle = circ
            local okConn, conn = pcall(function()
                return RunService.RenderStepped:Connect(function()
                    local cam = Workspace.CurrentCamera
                    if not cam then return end
                    circ.Position = cam.ViewportSize / 2
                    circ.Radius = tonumber(S.silentAimFOV) or 300
                    circ.Visible = S.silentAimOn and S.silentShowFOV
                end)
