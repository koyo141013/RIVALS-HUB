            local rm = ReplicatedStorage:FindFirstChild("Modules")
            local gm = rm and rm:FindFirstChild("GameplayUtility")
            if gm then _saGU = require(gm) end
        end)
        if _saGU and type(_saGU.GetEntitiesFromRaycast) == "function" then
