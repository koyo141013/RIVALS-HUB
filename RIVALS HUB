MakeConfigBtn("구성 저장", Color3.fromRGB(30, 140, 70), function()
    local snapshot = {
        Config = {},
        S = {},
        name = "구성_" .. os.date("%Y%m%d_%H%M%S"),
        time = os.date("%Y-%m-%d %H:%M:%S"),
    }
    for k, v in pairs(Config) do
        if type(v) == "table" then
            snapshot.Config[k] = {}
            for k2, v2 in pairs(v) do
                snapshot.Config[k][k2] = v2
            end
        else
            snapshot.Config[k] = v
        end
    end
    for k, v in pairs(S) do
        snapshot.S[k] = v
    end
    local jsonStr = ""
    local ok1, err1 = pcall(function() jsonStr = HttpService:JSONEncode(snapshot) end)
    if not ok1 then
        Notify("구성 저장", "JSON 직렬화 실패: " .. tostring(err1))
        return
    end
    local ok2, err2 = pcall(function() writefile(_ConfigDir .. "\\" .. snapshot.name .. ".json", jsonStr) end)
    if ok2 then
        Notify("구성 저장", snapshot.name .. ".json 저장됨")
    else
        Notify("구성 저장", "저장 실패: " .. tostring(err2))
    end
end)

MakeConfigBtn("구성 불러오기", Color3.fromRGB(70, 130, 255), function()
    local files = getfiles(_ConfigDir)
    if not files or #files == 0 then
        Notify("구성 불러오기", "저장된 구성이 없습니다")
        return
    end
    local latestFile = files[#files]
    local data = readfile(latestFile)
    if not data then
        Notify("구성 불러오기", "파일을 읽을 수 없습니다")
        return
    end
    local snapshot = nil
    local ok, err = pcall(function() snapshot = HttpService:JSONDecode(data) end)
    if not ok or not snapshot then
        Notify("구성 불러오기", "JSON 파싱 실패: " .. tostring(err))
        return
    end
    if snapshot.Config then for k, v in pairs(snapshot.Config) do Config[k] = v end end
    if snapshot.S then for k, v in pairs(snapshot.S) do S[k] = v end end
    Notify("구성 불러오기", string.match(latestFile, "([^\\]+)$") .. " 불러옴")
end)

