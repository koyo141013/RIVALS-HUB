        -- Z fn37 선택 반영
        local function setCardSelected(entry, selected)
            entry.Selected = selected
            if selected then
                entry.Card.BackgroundColor3 = Color3.fromRGB(50, 90, 160)
                entry.Title.TextColor3 = Color3.fromRGB(255, 255, 255)
                entry.Accent.BackgroundTransparency = 0
                entry.Indicator.BackgroundTransparency = 0
                entry.IndStroke.Transparency = 0
                entry.IndMark.TextTransparency = 0
            else
                entry.Card.BackgroundColor3 = CARD_BG
                entry.Title.TextColor3 = Color3.fromRGB(160, 160, 170)
                entry.Accent.BackgroundTransparency = 1
                entry.Indicator.BackgroundTransparency = 1
                entry.IndStroke.Transparency = 1
                entry.IndMark.TextTransparency = 1
            end
        end

        local wCards, cCards = {}, {}
        local function hookCard(list, entry)
            entry.Button.MouseEnter:Connect(function()
                if not entry.Selected then entry.Card.BackgroundColor3 = Color3.fromRGB(55, 55, 70) end
            end)
            entry.Button.MouseLeave:Connect(function()
                if not entry.Selected then entry.Card.BackgroundColor3 = CARD_BG end
            end)
            entry.Button.MouseButton1Click:Connect(function()
                for _, e in ipairs(list) do
                    if e ~= entry then setCardSelected(e, false) end
                end
                setCardSelected(entry, true)
                list._selected = entry.Name
            end)
        end

        local _wlist = {}
        do
            local _wset = {}
            for _, w in ipairs(_CC_Weapons) do
                if not _wset[w] then _wset[w] = true table.insert(_wlist, w) end
            end
            -- Kicia 방식: ItemLibrary에서 실제 무기 목록 추가 병합
            pcall(function()
                local mods = ReplicatedStorage:FindFirstChild("Modules")
                local ilib = mods and require(mods:FindFirstChild("ItemLibrary") or mods.ItemLibrary)
                local items = ilib and ilib.Items
                if type(items) == "table" then
                    for k, _ in pairs(items) do
                        if type(k) == "string" and not _wset[k] then
                            _wset[k] = true
                            table.insert(_wlist, k)
                        end
                    end
                end
            end)
            table.sort(_wlist)
        end
        for i, wname in ipairs(_wlist) do
            local card = makeZCard(wGrid, i, wname, PLACEHOLDER_IMG)
            hookCard(wCards, card)
            card.Button.MouseButton1Click:Connect(function()
                if rebuildCosmetics then rebuildCosmetics() end
            end)
            table.insert(wCards, card)
        end

        -- Kicia 방식: 선택된 무기+타입에 맞는 목록만 표시
        local function skinsForWeaponType(weapon, ctype)
            local out, seen = {}, {}
            local function push(n)
                if type(n) == "string" and not seen[n] then seen[n] = true table.insert(out, n) end
            end
            push("None")
            push("Random")
            if SkinState.Ready and SkinState.skinsByWeapon then
                if ctype == "Skin" then
                    local list = (type(weapon) == "string" and SkinState.skinsByWeapon[weapon]) or nil
                    if type(list) == "table" and #list > 0 then
                        for _, n in ipairs(list) do push(n) end
                    else
                        -- 무기별 정보가 없으면 전체 스킨 표시 (폴백)
                        if SkinState.typeByName then
                            local all = {}
                            for n, t in pairs(SkinState.typeByName) do
                                if t == "Skin" then table.insert(all, n) end
                            end
                            table.sort(all)
                            for _, n in ipairs(all) do push(n) end
                        end
                    end
                elseif SkinState.byType and type(SkinState.byType[ctype]) == "table" then
                    for _, n in ipairs(SkinState.byType[ctype]) do push(n) end
                end
            else
                local fb = BuildSkinList()
                for _, n in ipairs(fb) do push(n) end
            end
            return out
        end
        local function cosmeticImage(cname)
            local entry = env._harionCoss and env._harionCoss[cname]
            if type(entry) ~= "table" then return PLACEHOLDER_IMG end
            for _, k in ipairs({"Image", "ImageId", "Icon", "Thumbnail", "PreviewImage", "AssetId"}) do
                local v = entry[k]
                if type(v) == "string" and v ~= "" then
                    if tonumber(v) then return "rbxassetid://" .. v end
                    if string.find(v, "rbxasset") then return v end
                elseif type(v) == "number" and v > 0 then
                    return "rbxassetid://" .. tostring(v)
                end
            end
            return PLACEHOLDER_IMG
        end
        local function applyFilter(list, status, f)
            f = string.lower(f or "")
            local shown = 0
            for _, e in ipairs(list) do
                local vis = (f == "") or (string.find(e.SearchKey, f, 1, true) ~= nil)
                e.Object.Visible = vis
                if vis then shown += 1 end
            end
            if shown == 0 then
                status.Text = "No matches"
                status.Visible = true
            else
                status.Visible = false
            end
        end
        local _ctypes = {"Skin", "Wrap", "Charm"}
        local _ctypeIdx = 1
        local function rebuildCosmetics()
            for _, ch in ipairs(cGrid:GetChildren()) do
                if ch:IsA("GuiObject") then ch:Destroy() end
            end
            table.clear(cCards)
            cCards._selected = nil
            local ctype = (_ctypes and _ctypes[_ctypeIdx]) or "Skin"
            local weapon = wCards._selected
            local names = skinsForWeaponType(weapon, ctype)
            for i, cname in ipairs(names) do
                local card = makeZCard(cGrid, i, cname, cosmeticImage(cname))
                hookCard(cCards, card)
                table.insert(cCards, card)
            end
            local f = cFilter.Text or ""
            applyFilter(cCards, cStatus, f)
            if f == "" then
                if not SkinState.Ready then
                    cStatus.Text = "Catalog unavailable — join match"
                    cStatus.Visible = true
                elseif #names <= 2 then
                    cStatus.Text = "무기를 먼저 선택하세요"
                    cStatus.Visible = true
                end
            end
        end
        rebuildCosmetics()

        -- (applyFilter는 rebuildCosmetics보다 먼저 정의됨 — 아래 참조)
        wFilter:GetPropertyChangedSignal("Text"):Connect(function()
            applyFilter(wCards, wStatus, wFilter.Text)
        end)
        cFilter:GetPropertyChangedSignal("Text"):Connect(function()
            applyFilter(cCards, cStatus, cFilter.Text)
        end)

        local typeBtn = Instance.new("TextButton")
        typeBtn.Size = UDim2.new(1, -16, 0, 26)
        typeBtn.Position = UDim2.fromOffset(8, 546)
        typeBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        typeBtn.BorderSizePixel = 0
        typeBtn.Text = "skin                                           >"
        typeBtn.Font = Enum.Font.Code
        typeBtn.TextSize = 12
        typeBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
        typeBtn.Parent = win
        local tco = Instance.new("UICorner") tco.CornerRadius = UDim.new(0, 4) tco.Parent = typeBtn
        typeBtn.MouseButton1Click:Connect(function()
            _ctypeIdx = _ctypeIdx + 1
            if _ctypeIdx > #_ctypes then _ctypeIdx = 1 end
            typeBtn.Text = string.lower(_ctypes[_ctypeIdx]) .. "                                           >"
            if rebuildCosmetics then rebuildCosmetics() end
        end)

        local function bottomBtn(text, x, y, w, color)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, w, 0, 28)
            b.Position = UDim2.fromOffset(x, y)
            b.BackgroundColor3 = color
            b.BorderSizePixel = 0
            b.Text = text
            b.Font = Enum.Font.GothamBold
