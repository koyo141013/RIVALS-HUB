local SkinChanger = {}
SkinChanger.__index = SkinChanger

function SkinChanger.new()
    local self = setmetatable({}, SkinChanger)
    self.Enabled = false
    self.SelectedSkins = {}
    return self
end

function SkinChanger:ApplySkin(weaponName, skinName, ctype)
    ctype = ctype or "Skin"
    if not self.Enabled then
        return false, "SkinChanger OFF"
    end
    if not env._harionSkinSystemReady then
        pcall(function() env._installHarionSkin() end)
    end
    if not env._harionSkinSystemReady then
        return false, tostring(SkinState.LastError or "not ready")
    end
    local applied = false
    pcall(function()
        if type(env._applyCosmeticToWeapon) == "function" then
            applied = env._applyCosmeticToWeapon(weaponName, skinName, ctype) and true or false
        end
    end)
    if applied then
        self.SelectedSkins[weaponName] = skinName
        pcall(function()
            if SkinState.ensureCatalogVM then SkinState.ensureCatalogVM(weaponName, skinName) end
        end)
    end
    slog("apply", weaponName, skinName, ctype, applied and "OK" or "FAIL")
    return applied
end

function SkinChanger:Toggle(state)
    self.Enabled = state and true or false
    if self.Enabled then
        SkinState.hooksDisabled = false
        pcall(function() env._installHarionSkin() end)
        pcall(function() if env._installSkinViewModels then env._installSkinViewModels() end end)
        -- stale-hook 복구: 검증 실패 시 상태 초기화 후 재설치 1회
        local v = nil
        pcall(function()
            if type(SkinState.liveMergeTest) == "function" then v = SkinState.liveMergeTest() end
        end)
        if v == "fail" then
            SkinState.Ready = false
            env._harionSkinSystemReady = false
            SkinState.WDHooked = false
            SkinState.HookLayers = {}
            pcall(function() if SkinState.revertRename then SkinState.revertRename() end end)
            pcall(function() env._installHarionSkin() end)
        end
        print("[Kicia] SkinChanger Enabled")
    else
        SkinState.hooksDisabled = true
        pcall(function() if SkinState.clearAll then SkinState.clearAll() end end)
        self.SelectedSkins = {}
        print("[Kicia] SkinChanger Disabled (hooks bypassed)")
    end
end

