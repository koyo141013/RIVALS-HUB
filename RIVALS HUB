                    changed = true
                end
            end
            if not changed then
                mergeCache[wname] = { rev = mergeRev, src = original, merged = original }
                return original
            end
            merged.Level = original.Level
            merged.Prestige = original.Prestige
            merged.XP = original.XP
            mergeCache[wname] = { rev = mergeRev, src = original, merged = merged }
            return merged
        end
