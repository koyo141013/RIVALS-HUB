-- Kicia AmmoBar용: 장착 무기 탄약 읽기 (best-effort)
local function GetPlayerAmmoFrac(player)
    local frac, cur, max = nil, nil, nil
    pcall(function()
        local char = player and player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then return end
        for _, nm in ipairs({ "Ammo", "CurrentAmmo", "Mag", "Magazine", "Bullets", "ReserveAmmo" }) do
            local v = tool:FindFirstChild(nm, true)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                cur = v.Value
                break
            end
        end
        if cur == nil then
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("NumberValue") or d:IsA("IntValue") then
                    local n = string.lower(d.Name)
                    if string.find(n, "ammo", 1, true) or string.find(n, "mag", 1, true) then
                        cur = d.Value
                        break
                    end
                end
            end
        end
        if cur ~= nil then
            -- 맥스 추정: 같은 Tool 내 MaxAmmo 계열 우선
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("NumberValue") or d:IsA("IntValue") then
                    local n = string.lower(d.Name)
                    if string.find(n, "maxammo", 1, true) or string.find(n, "magsize", 1, true) or string.find(n, "mag_size", 1, true) then
                        max = d.Value
                        break
                    end
                end
            end
            if max == nil or max <= 0 then max = 30 end
            frac = math.clamp(cur / max, 0, 1)
        end
    end)
    return frac, cur, max
end

local function UpdateESPPlayer(player, viewportSize)
    local o = GetESP(player)
    do local hl = EspChams[player] if hl then pcall(function() hl.Enabled = false end) end end
    if not Config.ESP.Enabled or player == LocalPlayer then HideESP(o) return end
    if Config.ESP.TeamCheck and IsTeammate(player) and not Config.ESP.ShowTeammates then HideESP(o) return end
    local char = GetCharacter(player)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    if not char or not hum or hum.Health <= 0 or not hrp or not head then HideESP(o) return end
    local dist3d = (Camera.CFrame.Position - hrp.Position).Magnitude
    if dist3d > Config.ESP.MaxDistance then HideESP(o) return end

    local top3d = head.Position + Vector3.new(0, 0.6, 0)
    local bot3d = hrp.Position - Vector3.new(0, 3, 0)
    local top, topVis = Camera:WorldToViewportPoint(top3d)
    local bot, botVis = Camera:WorldToViewportPoint(bot3d)
    if not topVis and not botVis then HideESP(o) return end

    local h = math.abs(bot.Y - top.Y)
    local w = h * 0.6
    local x = bot.X - w / 2
    local y = top.Y

    local teammate = IsTeammate(player)
    local baseColor = teammate and Config.ESP.TeamColor or Config.ESP.BoxColor
    local obscured = false
    if LocalPlayer.Character then
        obscured = HasWallBetween(Camera.CFrame.Position, hrp.Position, { LocalPlayer.Character, char, Camera })
    end
    local color = obscured and Config.ESP.HiddenColor or baseColor
    if #o.skel == 0 then
        for i = 1, 15 do o.skel[i] = NewDraw("Line", { Thickness = 1, Visible = false, ZIndex = 2, Transparency = 1 }) end
        for i = 1, 8 do o.corners[i] = NewDraw("Line", { Thickness = 2, Visible = false, ZIndex = 2, Transparency = 1 }) end
        for i = 1, 4 do o.headCross[i] = NewDraw("Line", { Thickness = 1, Visible = false, ZIndex = 3, Transparency = 1 }) end
        for i = 1, 4 do o.headDiamond[i] = NewDraw("Line", { Thickness = 1, Visible = false, ZIndex = 3, Transparency = 1 }) end
    end

    -- Kicia Box Style: Full / Corner (원본: Box.Style)
    local wantCorner = Config.ESP.CornerBox or (Config.ESP.Boxes and (Config.ESP.BoxStyle == "Corner"))
    local wantFull = Config.ESP.Boxes and not wantCorner
    if wantFull then
        o.box.Visible = true; o.boxOutline.Visible = true
        o.box.Size = Vector2.new(w, h); o.box.Position = Vector2.new(x, y); o.box.Color = color
        o.boxOutline.Size = Vector2.new(w, h); o.boxOutline.Position = Vector2.new(x, y)
    else o.box.Visible = false; o.boxOutline.Visible = false end

    -- Kicia Filled Box (원본: FilledBox, Transparency 0.8 기본)
    if Config.ESP.FilledBox then
        o.filled.Visible = true
        o.filled.Size = Vector2.new(w, h); o.filled.Position = Vector2.new(x, y)
        o.filled.Color = color
        pcall(function() o.filled.Transparency = tonumber(Config.ESP.FilledBoxTransparency) or 0.7 end)
    else o.filled.Visible = false end

    -- Kicia HealthBar ColorMode: Solid / Gradient / Reactive (원본 그대로)
    if Config.ESP.HealthBar then
        local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local bw = 4
        o.hpBack.Visible = true
        o.hpBack.Size = Vector2.new(bw, h); o.hpBack.Position = Vector2.new(x - bw - 2, y)
        o.hpFront.Visible = true
        o.hpFront.Size = Vector2.new(bw - 2, h * frac)
        o.hpFront.Position = Vector2.new(x - bw - 1, y + h * (1 - frac))
        local mode = Config.ESP.HealthBarMode or "Reactive"
        if mode == "Solid" then
            o.hpFront.Color = Color3.fromRGB(0, 255, 0)
        elseif mode == "Gradient" then
            o.hpFront.Color = Color3.fromRGB(math.floor(255 * (1 - frac)), math.floor(255 * frac), 0)
        else
            o.hpFront.Color = Color3.fromHSV(frac * 0.33, 1, 1)
        end
    else o.hpBack.Visible = false; o.hpFront.Visible = false end

    -- Kicia AmmoBar (원본: 하단 수평 바, ColorMode 동일)
    if Config.ESP.AmmoBar then
        local frac = GetPlayerAmmoFrac(player)
        if frac ~= nil then
            local bh = 3
            o.ammoBack.Visible = true
            o.ammoBack.Size = Vector2.new(w, bh); o.ammoBack.Position = Vector2.new(x, bot.Y + 1)
            o.ammoFront.Visible = true
            o.ammoFront.Size = Vector2.new(w * frac, bh - 1); o.ammoFront.Position = Vector2.new(x, bot.Y + 1)
            local mode = Config.ESP.AmmoBarMode or "Reactive"
            if mode == "Solid" then
                o.ammoFront.Color = Color3.fromRGB(0, 170, 255)
            elseif mode == "Gradient" then
                o.ammoFront.Color = Color3.fromRGB(math.floor(255 * (1 - frac)), math.floor(170 * frac + 85), 255)
            else
                o.ammoFront.Color = Color3.fromHSV(0.58 - 0.15 * (1 - frac), 1, 1)
            end
        else
            o.ammoBack.Visible = false; o.ammoFront.Visible = false
        end
    else o.ammoBack.Visible = false; o.ammoFront.Visible = false end

    if Config.ESP.Names then
        o.name.Visible = true
        o.name.Text = (player.DisplayName ~= player.Name) and (player.DisplayName .. " (@" .. player.Name .. ")") or player.Name
        o.name.Position = Vector2.new(bot.X, y - 16)
        o.name.Color = color
    else o.name.Visible = false end

    if Config.ESP.Distance then
        o.dist.Visible = true
        o.dist.Text = string.format("%dm", math.floor(dist3d))
        o.dist.Position = Vector2.new(bot.X, bot.Y + 2)
    else o.dist.Visible = false end

    -- Kicia Tracer (원본: From Bottom/Center/Top/Mouse, To Feet/Head, Thickness, Outline)
    if Config.ESP.Snaplines then
        local org = Config.ESP.TracerOrigin or "Bottom"
        local from = Vector2.new(viewportSize.X / 2, viewportSize.Y)
        if org == "Center" then from = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        elseif org == "Top" then from = Vector2.new(viewportSize.X / 2, 0)
        elseif org == "Mouse" then pcall(function() from = UserInputService:GetMouseLocation() end) end
        local toPos = Vector2.new(bot.X, bot.Y)
        if (Config.ESP.TracerTarget or "Feet") == "Head" then
            local hp2d, hvis = Camera:WorldToViewportPoint(head.Position)
            if hvis then toPos = Vector2.new(hp2d.X, hp2d.Y) end
        end
        local th = math.clamp(tonumber(Config.ESP.TracerThickness) or 1, 1, 6)
        o.line.Visible = true
        o.line.From = from
        o.line.To = toPos
        o.line.Color = color
        pcall(function() o.line.Thickness = th end)
        if Config.ESP.TracerOutline then
            o.lineOutline.Visible = true
            o.lineOutline.From = from
            o.lineOutline.To = toPos
            pcall(function() o.lineOutline.Thickness = th + 2 end)
        else o.lineOutline.Visible = false end
    else o.line.Visible = false o.lineOutline.Visible = false end

    if wantCorner then
        local L = math.min(w, h) * 0.25
        local pts = {
            {x, y, x + L, y}, {x, y, x, y + L},
            {x + w - L, y, x + w, y}, {x + w, y, x + w, y + L},
            {x, y + h - L, x, y + h}, {x, y + h, x + L, y + h},
            {x + w - L, y + h, x + w, y + h}, {x + w, y + h - L, x + w, y + h},
        }
        for i, s in ipairs(pts) do
            local ln = o.corners[i]
            ln.Visible = true
            ln.From = Vector2.new(s[1], s[2]); ln.To = Vector2.new(s[3], s[4]); ln.Color = color
        end
    else for _, ln in ipairs(o.corners) do ln.Visible = false end end

    if Config.ESP.HealthNumber then
        o.hpNum.Visible = true
        o.hpNum.Text = tostring(math.floor(hum.Health + 0.5))
        o.hpNum.Position = Vector2.new(x - 32, y)
        o.hpNum.Color = Color3.fromRGB(255, 255, 255)
    else o.hpNum.Visible = false end

    local heldName = nil
    if Config.ESP.HeldWeapon or Config.ESP.Deflecting then
        pcall(function() heldName = GetPlayerWeaponName(player) end)
    end
    if Config.ESP.HeldWeapon then
        o.wpn.Visible = true
        o.wpn.Text = heldName or "--"
        o.wpn.Position = Vector2.new(bot.X, bot.Y + 16)
        o.wpn.Color = Color3.fromRGB(144, 255, 160)
    else o.wpn.Visible = false end

    if Config.ESP.Rank then
        local rt = GetPlayerRankText(player)
        if rt then o.rank.Visible = true o.rank.Text = "RANK " .. rt o.rank.Position = Vector2.new(bot.X, y - 30) o.rank.Color = Color3.fromRGB(192, 192, 255)
        else o.rank.Visible = false end
    else o.rank.Visible = false end

    if Config.ESP.Winstreak then
        local wst = GetPlayerWinstreak(player)
        if wst then o.ws.Visible = true o.ws.Text = "WS " .. wst o.ws.Position = Vector2.new(bot.X, y - 44) o.ws.Color = Color3.fromRGB(255, 224, 128)
        else o.ws.Visible = false end
    else o.ws.Visible = false end

    if Config.ESP.Deflecting then
        local isKat = heldName and string.find(string.lower(heldName), "katana", 1, true)
        if isKat then o.deflect.Visible = true o.deflect.Text = "DEFLECT" o.deflect.Position = Vector2.new(bot.X, bot.Y + 30) o.deflect.Color = Color3.fromRGB(255, 80, 80)
        else o.deflect.Visible = false end
    else o.deflect.Visible = false end

    -- Kicia HeadMarker (원본: Shape Cross/Circle/Diamond, Filled, Outline)
    do
        for _, ln in ipairs(o.headCross) do ln.Visible = false end
        for _, ln in ipairs(o.headDiamond) do ln.Visible = false end
        o.headdot.Visible = false
        if Config.ESP.HeadDot then
            local hp2d, hvis = Camera:WorldToViewportPoint(head.Position)
            if hvis then
                local shape = Config.ESP.HeadMarkerShape or "Circle"
                local hp = Vector2.new(hp2d.X, hp2d.Y)
                local r = 6
                if shape == "Circle" then
                    o.headdot.Visible = true o.headdot.Position = hp o.headdot.Color = color
                    o.headdot.Radius = r
                    pcall(function() o.headdot.Filled = Config.ESP.HeadMarkerFilled ~= false end)
                    pcall(function() o.headdot.Thickness = (Config.ESP.HeadMarkerOutline and 2 or 1) end)
                elseif shape == "Cross" then
                    local segs = {
                        {hp + Vector2.new(-r, 0), hp + Vector2.new(-2, 0)},
                        {hp + Vector2.new(2, 0), hp + Vector2.new(r, 0)},
                        {hp + Vector2.new(0, -r), hp + Vector2.new(0, -2)},
                        {hp + Vector2.new(0, 2), hp + Vector2.new(0, r)},
                    }
                    for i, s in ipairs(segs) do
                        local ln = o.headCross[i]
                        if ln then
                            ln.Visible = true; ln.From = s[1]; ln.To = s[2]; ln.Color = color
                            pcall(function() ln.Thickness = Config.ESP.HeadMarkerOutline and 2 or 1 end)
                        end
                    end
