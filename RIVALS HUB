            b.TextColor3 = Color3.fromRGB(255, 255, 255)
            b.Parent = win
            local co = Instance.new("UICorner") co.CornerRadius = UDim.new(0, 4) co.Parent = b
            return b
        end
        local applyBtn = bottomBtn("apply selected to all", 8, 576, 644, Color3.fromRGB(30, 140, 70))
        applyBtn.MouseButton1Click:Connect(function()
            if not _KiciaSkinChanger.Enabled then
                Notify("스킨체인저", "Skin Changer를 먼저 켜세요")
                return
            end
            local weapon = wCards._selected
            local cosmetic = cCards._selected
            if not weapon then Notify("스킨체인저", "무기를 선택하세요") return end
            if not cosmetic then cosmetic = "None" end
            local ctype = _ctypes[_ctypeIdx] or "Skin"
            local ok, reason = _KiciaSkinChanger:ApplySkin(weapon, cosmetic, ctype)
            if ok then
                Notify("스킨체인저", weapon .. "에 " .. cosmetic .. " (" .. ctype .. ") 적용됨")
            else
                Notify("스킨체인저", "적용 실패: " .. tostring(reason or "코스틱 이름을 확인하세요"))
            end
            slog("grid-apply", weapon, cosmetic, ctype, ok and "OK" or ("FAIL:" .. tostring(reason)))
        end)

        local resetBtn = bottomBtn("reset to defaults", 8, 608, 318, Color3.fromRGB(130, 40, 40))
        resetBtn.MouseButton1Click:Connect(function()
            if not _KiciaSkinChanger.Enabled then
                Notify("스킨체인저", "Skin Changer를 먼저 켜세요")
                return
            end
            if type(env._applyCosmeticToWeapon) ~= "function" then
                Notify("스킨체인저", "스킨 시스템이 아직 준비되지 않았습니다")
                return
            end
            for wname, _ in pairs(_KiciaSkinChanger.SelectedSkins) do
                env._applyCosmeticToWeapon(wname, "None", "Skin")
                env._applyCosmeticToWeapon(wname, "None", "Wrap")
                env._applyCosmeticToWeapon(wname, "None", "Charm")
            end
            for wname, _ in pairs(SkinState.equip) do
                env._applyCosmeticToWeapon(wname, "None", "Skin")
                env._applyCosmeticToWeapon(wname, "None", "Wrap")
                env._applyCosmeticToWeapon(wname, "None", "Charm")
            end
            SkinState.equip = {}
            _KiciaSkinChanger.SelectedSkins = {}
            Notify("스킨체인저", "모든 스킨 초기화됨")
        end)

        local closeBtn = bottomBtn("close", 334, 608, 318, Color3.fromRGB(40, 40, 50))
        closeBtn.MouseButton1Click:Connect(function()
            if getgenv().RivalsCCWindow == ccGui then getgenv().RivalsCCWindow = nil end
            ccGui:Destroy()
        end)

        local hint = Instance.new("TextLabel")
        hint.Size = UDim2.new(1, -16, 0, 16)
        hint.Position = UDim2.fromOffset(8, 640)
        hint.BackgroundTransparency = 1
        hint.Text = "right click a weapon to toggle the skin changer for it."
        hint.Font = Enum.Font.Code
        hint.TextSize = 10
        hint.TextColor3 = Color3.fromRGB(120, 120, 130)
        hint.Parent = win
    end,
})
