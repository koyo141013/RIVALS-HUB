-- ============ No Spread (No Recoil) Module ============
local function patchInfoTableNoRecoil(info)
    if type(info) ~= "table" then return end
    if not env._rivNoRecoil then return end
    for _, k in ipairs({
        "ShootRecoil", "ShootSpread", "Recoil", "Spread", "Bloom", "BloomMax", "BloomMin",
        "RecoilMin", "RecoilMax", "VerticalRecoil", "HorizontalRecoil", "CameraRecoil",
        "AimSpread", "HipSpread", "SpreadMultiplier", "RecoilMultiplier", "Kick",
        "ViewKick", "Punch", "Inaccuracy"
    }) do
        local v = rawget(info, k)
        if type(v) == "number" then rawset(info, k, 0) end
    end
    if rawget(info, "ProjectileSpeed") ~= nil then
        rawset(info, "ProjectileSpeed", 99999999999)
    end
end

task.spawn(function()
    local ok, modulesFolder = pcall(function() return game:GetService("ReplicatedStorage"):WaitForChild("Modules", 8) end)
    if not ok then return end
    local clientItemModule = modulesFolder:FindFirstChild("ClientItem")
    if clientItemModule then
        local ok, ClientItem = pcall(require, clientItemModule)
        if ok and ClientItem then
            local origInput = rawget(ClientItem, "Input") or ClientItem.Input
            if type(origInput) == "function" then
                env._hookOrig = env._hookOrig or {}
                env._hookOrig.InputNR = { mod = ClientItem, fn = origInput }
                rawset(ClientItem, "Input", function(self, ...)
                    if not hookGuard("InputNR") then
                        return origInput(self, ...)
                    end
                    if self and type(self) == "table" and self.Info and env._rivNoRecoil then
                        pcall(patchInfoTableNoRecoil, self.Info)
                    end
                    local res = origInput(self, ...)
                    hookUnguard("InputNR")
                    return res
                end)
            end
        end
    end
    local gunModule = modulesFolder:FindFirstChild("Gun") or modulesFolder:FindFirstChild("GunItem")
    if gunModule then
        local ok, Gun = pcall(require, gunModule)
        if ok and Gun then
            local origStart = rawget(Gun, "StartShooting") or Gun.StartShooting
            if type(origStart) == "function" then
                regRestore(function()
                    pcall(function() rawset(Gun, "StartShooting", origStart) end)
                end)
                rawset(Gun, "StartShooting", function(self, ...)
                    if self and type(self) == "table" and self.Info and env._rivNoRecoil then
                        pcall(patchInfoTableNoRecoil, self.Info)
                    end
                    return origStart(self, ...)
                end)
            end
        end
    end
end)

