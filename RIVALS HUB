AimbotBox:AddToggle("RIV_InputHooks", {
    Text = T("Restore Hooks (전체 원복)", "Restore Hooks (Restore All)"),
    Default = true,
    Callback = function(v)
        if v then
            Notify("Hooks", T("ON - 재실행 시 재설치됨", "ON - reinstalls on re-execute"))
        else
            local H = env._hookOrig or {}
            local n = 0
            for _, e in pairs(H) do
                if type(e) == "table" and e.mod and e.fn then
                    if pcall(function() rawset(e.mod, "Input", e.fn) end) then
                        n += 1
                    end
                end
            end
            local R = getgenv().RivalsHookRestore or {}
            for _, fn in ipairs(R) do
                if type(fn) == "function" then
                    if pcall(fn) then n += 1 end
                end
            end
            Notify("Hooks", "OFF - " .. n .. T("개 원복됨", " restored"))
        end
    end,
})
