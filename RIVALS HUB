local SavedMouseBehavior = nil
local SavedMouseIcon = nil
local function ApplyMenuSideEffects(open)
    if open then
        _savedRagebotOn = S.ragebotOn
        _savedTriggerBotOn = S.triggerBotOn
        S.ragebotOn = false
        S.triggerBotOn = false
        pcall(function()
            SavedMouseBehavior = UserInputService.MouseBehavior
            SavedMouseIcon = UserInputService.MouseIconEnabled
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
    else
        S.ragebotOn = _savedRagebotOn
        S.triggerBotOn = _savedTriggerBotOn
        task.defer(function()
            task.wait(0.05)
            pcall(function()
                if SavedMouseBehavior ~= nil then
                    UserInputService.MouseBehavior = SavedMouseBehavior
                else
                    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                end
                if SavedMouseIcon ~= nil then
                    UserInputService.MouseIconEnabled = SavedMouseIcon
                else
                    UserInputService.MouseIconEnabled = false
                end
            end)
        end)
    end
end
Options.MenuKeybind:OnClick(function()
    MenuOpen = not MenuOpen
    ApplyMenuSideEffects(MenuOpen)
end)
