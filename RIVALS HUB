local function patchInfoTableFast(info)
    if type(info) ~= "table" then return end
    if not env._rivRapidFire then return end
    rawset(info, "ShootCooldown", 0)
    rawset(info, "QuickShotCooldown", 0)
    rawset(info, "FireRate", 0)
    rawset(info, "Delay", 0)
    if rawget(info, "Cooldown") ~= nil and type(rawget(info, "Cooldown")) == "number" then
        rawset(info, "Cooldown", 0)
    end
    if rawget(info, "Auto") ~= nil then rawset(info, "Auto", true) end
    if rawget(info, "AutoFire") ~= nil then rawset(info, "AutoFire", true) end
    if rawget(info, "Automatic") ~= nil then rawset(info, "Automatic", true) end
end

