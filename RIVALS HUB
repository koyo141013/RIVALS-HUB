local _rageCurTarget, _rageStableAt = nil, 0
local function RagebotStep_KICIA_DISABLED()
    if not S.ragebotOn or MenuOpen then return end
    local now = os.clock()
    local target = getBestTarget(Config.Aimbot.FOV)
    if not target then
        _rageCurTarget = nil
        env._rageStage = "NoTarget"
        return
    end
    RAGE_D.targets += 1
    env._rageTargets = RAGE_D.targets
    local ch = target.Parent
    if ch then
        local skip = false
        pcall(function()
            local plr = Players:GetPlayerFromCharacter(ch)
            if plr and LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
                skip = true
            end
        end)
        if skip then env._rageStage = "Teammate" return end
        if not ResolveShotSafe(ch) then env._rageStage = "Blocked" return end
    end
    -- HitboxHead 우선 (Kicia AliveState.HitboxHead)
    local head = ch and (ch:FindFirstChild("HitboxHead") or ch:FindFirstChild("Head")) or target
    if not head or not head:IsA("BasePart") then env._rageStage = "NoHead" return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then env._rageStage = "NoSelf" return end
    -- 타깃 교체 시 Stability 대기 (Kicia SpatialLimitGate)
    if _rageCurTarget ~= ch then
        _rageCurTarget = ch
        _rageStableAt = now + (tonumber(S.ragebotStability) or 0.15)
    end
    -- desync: 타깃 위/뒤로 순간이동 후 복구 (Kicia Plan의 n + __restore)
    local isKnife = false
    pcall(function()
        local tool = ch:FindFirstChildOfClass("Tool")
        if tool and string.find(string.lower(tool.Name), "knife", 1, true) then isKnife = true end
    end)
    local oldCF, oldVel, oldRotVel = myRoot.CFrame, myRoot.Velocity, myRoot.RotVelocity
    pcall(function()
        local tRoot = ch:FindFirstChild("HumanoidRootPart")
        local base = (tRoot and tRoot.CFrame or head.CFrame)
        myRoot.CFrame = base * (isKnife and CFrame.new(0, 6, 0) or CFrame.new(0, 1, 2))
        pcall(function() RunService:UnbindFromRenderStep("__restore") end)
        RunService:BindToRenderStep("__restore", 101, function()
            if myRoot then
                myRoot.CFrame = oldCF
                myRoot.Velocity = oldVel
                myRoot.RotVelocity = oldRotVel
            end
            RunService:UnbindFromRenderStep("__restore")
        end)
    end)
    if now < _rageStableAt then env._rageStage = "Stabilizing" return end
    local fr = math.max(tonumber(S.ragebotFireRate) or 0.05, 0.03)
    if now - _rageLastFire < fr * math.max(tonumber(S.ragebotShootFrames) or 1, 1) then
        env._rageStage = "Cooling"
        return
    end
    -- 나이프/근접은 HeavyAttack 인코딩을 모르므로 클릭 폴백
    if isKnife then
        local click = env._clickFn
        if click == nil then env._rageStage = "MeleeNoClick" return end
        _rageLastFire = now
        RAGE_D.shots += 1
        env._rageShots = RAGE_D.shots
        env._rageStage = "MeleeClick"
        _rageStatusTick(false)
        pcall(click)
        return
    end
    local M = rageModules()
    if not M then env._rageStage = "NoMod" return end
    local item, oid, fan, ray = rageGetGun(M)
    if not item then env._rageStage = "NoItem" return end
    local startShoot = rageStartEnum(M)
    if startShoot == nil then env._rageStage = "NoEnum" return end
    local useItem = rageGetUseItem()
    if not useItem then env._rageStage = "NoRemote" return end
    -- Kicia ShootEncoded 그대로: data + raycast 플래그
    local below = (myRoot.Position.Y - head.Position.Y) > 3
    local data = {
        [utf8.char(0)] = below and K_RAGE.AB or K_RAGE.A,
        [utf8.char(1)] = below and K_RAGE.BB or K_RAGE.B,
        [utf8.char(2)] = head,
        [utf8.char(3)] = K_RAGE.C,
        [utf8.char(4)] = fan,
    }
    local payload = { [utf8.char(1)] = data }
    if ray ~= false then payload[utf8.char(2)] = true end
    local okFire = pcall(function()
        useItem:FireServer(oid, startShoot, payload, nil)
    end)
    if okFire then
        _rageLastFire = now
        RAGE_D.shots += 1
        env._rageShots = RAGE_D.shots
        env._rageStage = "Fired"
        _rageStatusTick(false)
    else
        env._rageStage = "FireErr"
    end
end
end -- RAGE-KICIA-OFF-END

