local LANG_IS_KO = true
local LANG_ID = ""
local function _readLangFile()
    local out = nil
    pcall(function()
        if type(isfile) == "function" and isfile("RivalsHub/lang.txt")
            and type(readfile) == "function" then
            local c = tostring(readfile("RivalsHub/lang.txt") or ""):lower():match("^%s*(.-)%s*$")
            if c == "ko" or c == "en" then out = c end
        end
    end)
    return out
end
