local function rageModules()
    if _rageMods ~= nil then
        return _rageMods or nil
    end
    local M = {}
    pcall(function()
        local rm = ReplicatedStorage:FindFirstChild("Modules")
        local um = rm and rm:FindFirstChild("Utility")
        if um then M.U = require(um) end
        local em = rm and rm:FindFirstChild("EnumLibrary")
        if em then M.EL = require(em) end
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        local ct = ps and ps:FindFirstChild("Controllers")
        local fm = ct and ct:FindFirstChild("FighterController")
        if fm then M.FC = require(fm) end
        local sm = ct and (ct:FindFirstChild("SpectateController") or ct:WaitForChild("SpectateController", 3))
        if sm then
            local okS, sc = pcall(require, sm)
            if okS then M.SC = sc end
        end
    end)
    if M.U and M.EL and M.FC then
        _rageMods = M
        return M
    end
    _rageMods = false
    task.delay(10, function() if _rageMods == false then _rageMods = nil end end)
    return nil
end

local function rageUpdateDeflection(FC)
    if not FC or not FC.Objects then return end
    local seen = {}
    for _, fighterObj in pairs(FC.Objects) do
        local ok, player = pcall(function() return fighterObj.Player end)
        if ok and player then
            seen[player] = true
            local alive, spectating, equipped = false, true, nil
            pcall(function()
                alive = fighterObj.Entity and fighterObj.Entity:IsAlive()
                spectating = fighterObj:Get("IsSpectating")
                equipped = fighterObj.EquippedItem
            end)
            if not alive or spectating then
                _rageDeflecting[player] = false
            else
                local vmName = nil
                pcall(function()
                    vmName = equipped and equipped.ViewModel and equipped.ViewModel.Name
                end)
                local isDeflecting = false
                if vmName == "Katana" and equipped then
                    pcall(function()
                        isDeflecting = (equipped._attack_cooldown and equipped._attack_cooldown > tick()) or false
                    end)
                end
                _rageDeflecting[player] = isDeflecting
            end
        end
    end
    for plr, _ in pairs(_rageDeflecting) do
        if not seen[plr] then _rageDeflecting[plr] = nil end
    end
end

local function rageIsEnemy(player)
    if player == LocalPlayer then return false end
    local M = _rageMods
    if M and M.SC then
        local ok, res = pcall(function()
            local duel = M.SC.CurrentDuelSubject
            local localDueler = duel and duel:GetDueler(LocalPlayer)
            local localTeam = localDueler and localDueler:Get("TeamID") or nil
            if localTeam and duel and duel.Duelers then
                for _, dueler in pairs(duel.Duelers) do
                    if dueler.Player == player then
                        return dueler:Get("TeamID") ~= localTeam
                    end
                end
                return nil
            end
            return nil
        end)
        if ok and res ~= nil then return res end
    end
    local pTeam, lTeam = nil, nil
    pcall(function() pTeam = player:GetAttribute("TeamID") end)
    pcall(function() lTeam = LocalPlayer:GetAttribute("TeamID") end)
    if pTeam and lTeam then return pTeam ~= lTeam end
    return true
end

local function rageClosestTarget()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil, nil end
    local closestPlayer, closestRoot, closestHead, closestDist = nil, nil, nil, 500
    for _, player in pairs(Players:GetPlayers()) do
        if rageIsEnemy(player) then
            local pChar = player.Character
            if pChar then
                local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                local pHead = pChar:FindFirstChild("Head")
                local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
                if pRoot and pHead and pHum and pHum.Health > 0 then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPlayer = player
                        closestRoot = pRoot
                        closestHead = pHead
                    end
                end
            end
        end
    end
    return closestPlayer, closestRoot, closestHead
end

local function rageHasKnifeViewModel(targetPlayer)
    if not targetPlayer then return false end
    local viewModels = Workspace:FindFirstChild("ViewModels")
    if not viewModels then return false end
    local targetName = targetPlayer.Name
    for _, model in pairs(viewModels:GetChildren()) do
        if model:IsA("Model")
            and string.find(model.Name, targetName, 1, true)
            and string.find(model.Name, "Knife", 1, true) then
            return true
        end
    end
    return false
end

local _knifeCache = {}
local function rageHasKnifeCached(targetPlayer)
    local now = os.clock()
    local e = targetPlayer and _knifeCache[targetPlayer] or nil
    if e and now - e.t < 1 then return e.v end
    local v = rageHasKnifeViewModel(targetPlayer)
    if targetPlayer then _knifeCache[targetPlayer] = { v = v, t = now } end
    return v
end

