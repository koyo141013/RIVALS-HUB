-- 메뉴 열림/닫힘 ↔ 레이지봇/트리거봇 일시정지 동기화
local SavedMouseBehavior = nil
local SavedMouseIcon = nil
local function ApplyMenuSideEffects(open)
    -- NOTE: RagebotStep/TriggerBotStep/EvasionStep은 이미 MenuOpen 게이트로 열림 중 일시정지되므로
    -- S.ragebotOn/S.triggerBotOn을 직접 건드리지 않는다 (열린 채 켠 토글이 닫힐 때 꺼지던 버그).
    if open then
        pcall(function()
            SavedMouseBehavior = UserInputService.MouseBehavior
            SavedMouseIcon = UserInputService.MouseIconEnabled
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
    else
        task.defer(function()
            task.wait(0.05)
            pcall(function()
                if SavedMouseBehavior ~= nil then
                    UserInputService.MouseBehavior = SavedMouseBehavior
                else
                    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                end
                if SavedMouseIcon ~= nil then
                    UserInputService.MouseIconEnabled = SavedMouseIcon
                else
                    UserInputService.MouseIconEnabled = false
                end
            end)
        end)
    end
end
Options.MenuKeybind:OnClick(function()
    MenuOpen = not MenuOpen
    ApplyMenuSideEffects(MenuOpen)
end)
task.spawn(function()
    while not getgenv().RivalsHubDead do
        task.wait(0.25)
        local ok, vis = pcall(function() return Library.Toggled end)
        if ok and type(vis) == "boolean" and vis ~= MenuOpen then
            MenuOpen = vis
            ApplyMenuSideEffects(vis)
        end
    end
end)
pcall(function()
    SavedMouseBehavior = UserInputService.MouseBehavior
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
end)

