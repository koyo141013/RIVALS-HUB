-- ============ Resolver (Kicia dots: Front -0.3778 / Back 0.70355 / Deflect -0.71366) ============
local function ResolveShotSafe(targetChar)
    if not S.ragebotResolver then return true end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return true end
    local tool = targetChar:FindFirstChildOfClass("Tool")
    local tn = tool and string.lower(tool.Name) or ""
    local blocking = (string.find(tn, "riot shield", 1, true) or string.find(tn, "katana", 1, true)) and true or false
    if not blocking then return true end
    local diff = myRoot.Position - tRoot.Position
    local dir = diff.Magnitude > 0 and diff.Unit or Vector3.new(0, 0, 1)
    local d = tRoot.CFrame.LookVector:Dot(dir)
    if d > 0.35 then return false end
    return true
end

-- ============ Evasion (Kicia modes: Random / Translocate) ============
local _evasionAnchor = nil
local _evasionLast = 0
local function EvasionStep()
    if S.ragebotEvasion == "Off" or not S.ragebotOn or MenuOpen or IsPickWeaponsOpen() then return end
    local now = os.clock()
    if now - _evasionLast < 0.3 then return end
    _evasionLast = now
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if not _evasionAnchor or (root.Position - _evasionAnchor.Position).Magnitude > 60 then
        _evasionAnchor = root.CFrame
    end
    local cf = _evasionAnchor
    if S.ragebotEvasion == "Random" then
        local r = math.clamp(tonumber(S.evasionRadius) or 8, 2, 30)
        cf = _evasionAnchor * CFrame.new(math.random() * 2 * r - r, 0, math.random() * 2 * r - r)
    elseif S.ragebotEvasion == "Translocate" then
        cf = _evasionAnchor + Vector3.new(0, -5, 0)
    else
        return
    end
    local savedCF = root.CFrame
    local savedVel = root.AssemblyLinearVelocity
    local savedRot = root.AssemblyAngularVelocity
    pcall(function()
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    pcall(function()
        RunService:BindToRenderStep("__evasionRestore", Enum.RenderPriority.Camera.Value - 1, function()
            local r2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if r2 then
                r2.CFrame = savedCF
                r2.AssemblyLinearVelocity = savedVel
                r2.AssemblyAngularVelocity = savedRot
            end
            pcall(function() RunService:UnbindFromRenderStep("__evasionRestore") end)
        end)
    end)
end

local function getBestTarget(fovLimit)
    local currentCam = Workspace.CurrentCamera or Workspace:FindFirstChildOfClass("Camera")
    if not currentCam then return nil end
    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget = nil
    local shortestDist = fovLimit or 150
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head and head:IsA("BasePart") then
                local ok, screenPos, onScreen = pcall(function()
                    return currentCam:WorldToViewportPoint(head.Position)
                end)
                if ok and onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTarget = head
                    end
                end
            end
        end
    end
    return bestTarget
end

