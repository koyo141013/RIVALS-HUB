local LoadoutCfg = {
    Enabled = false,
    Silent = false,
    Weapons = { [1] = "Assault Rifle", [2] = "Handgun", [3] = "Fists", [4] = "Grenade" },
}
local function pickLoadout(force)
    if not LoadoutCfg.Enabled then return end
    local sig = table.concat({tostring(LoadoutCfg.Weapons[1]), tostring(LoadoutCfg.Weapons[2]), tostring(LoadoutCfg.Weapons[3]), tostring(LoadoutCfg.Weapons[4])}, "|")
    if not force and LoadoutCfg.LastSent == sig then return end
    LoadoutCfg.LastSent = sig
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local remotes = RS:FindFirstChild("Remotes") or RS:FindFirstChild("Remote")
        if not remotes then return end
        local replication = remotes:FindFirstChild("Replication")
        if not replication then return end
        local fighter = replication:FindFirstChild("Fighter")
        if not fighter then return end
        local pw = fighter:FindFirstChild("PickWeapons")
        if not pw or not pw:IsA("RemoteEvent") then return end
        pw:FireServer(
            LoadoutCfg.Weapons[1],
            LoadoutCfg.Weapons[2],
            LoadoutCfg.Weapons[3],
            LoadoutCfg.Weapons[4]
        )
    end)
    if not LoadoutCfg.Silent then
        print("[Loadout] pick sent:", LoadoutCfg.Weapons[1], LoadoutCfg.Weapons[2], LoadoutCfg.Weapons[3], LoadoutCfg.Weapons[4])
    end
end
local _loadoutLoopRunning = false
local function runLoadoutLoop()
    if _loadoutLoopRunning then return end
    _loadoutLoopRunning = true
    task.spawn(function()
        while not getgenv().RivalsHubDead and LoadoutCfg.Enabled do
            pcall(pickLoadout)
            task.wait(0.5)
        end
        _loadoutLoopRunning = false
    end)
end

