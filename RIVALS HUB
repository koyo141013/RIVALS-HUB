                            dir = (t.Position - origin).Unit
                            if dist > maxDist then maxDist = dist + 5 end
                        end)
                    end
                end
                return origRay(self, envID, params, origin, dir, maxDist, ...)
            end
            _saRayHooked = true
        end
    end
    if not _saUseHooked and type(hookfunction) == "function" then
        local useItem = nil
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local rep = remotes and remotes:FindFirstChild("Replication")
            local fg = rep and rep:FindFirstChild("Fighter")
            local ui = fg and fg:FindFirstChild("UseItem")
            if ui and ui:IsA("RemoteEvent") then useItem = ui end
        end)
        if useItem then
            saEnsureMod()
            local startShoot = nil
            if _saEL then pcall(function() startShoot = _saEL:ToEnum("StartShooting") end) end
            local hookPrev = useItem.FireServer
            local okH = pcall(function()
                local fn = function(self, objID, enumVal, camdata, extra)
                    if S.silentAimOn and not MenuOpen then
                        local match = (startShoot ~= nil and enumVal == startShoot) or tostring(enumVal) == "StartShooting"
