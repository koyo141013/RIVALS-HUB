    if input.UserInputType == Config.Aimbot.HoldKey then
        Holding = false
    end
end))

-- ============ Main loop ============
table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if MenuOpen then
        pcall(function()
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if not UserInputService.MouseIconEnabled then
                UserInputService.MouseIconEnabled = true
            end
        end)
        if not ScreenGui.Parent then
            pcall(function() ScreenGui.Parent = GetGuiParent() end)
        end
        if not ScreenGui.Enabled then
            ScreenGui.Enabled = true
        end
    end

    local viewportSize = Camera.ViewportSize
    local mouse = UserInputService:GetMouseLocation()

    FOVCircle.Position = mouse
    FOVOutline.Position = mouse
    FOVCircle.Visible = Config.Aimbot.Enabled and not MenuOpen
    FOVOutline.Visible = Config.Aimbot.Enabled and not MenuOpen

    if Config.Walk.Enabled then
        local ch = LocalPlayer.Character
        local hh = ch and ch:FindFirstChildOfClass("Humanoid")
        if hh then
            pcall(function() hh.WalkSpeed = math.max(Config.Walk.Speed, DEFAULT_WALK) end)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        local ok, err = pcall(UpdateESPPlayer, plr, viewportSize)
        if not ok then warn(err) end
    end
    for plr, objs in pairs(ESPObjects) do
        if not plr.Parent then HideESP(objs) ESPObjects[plr] = nil end
    end

    if Config.Aimbot.Enabled and not MenuOpen then
        local canMove = true
        if iswindowactive then
            local ok, active = pcall(iswindowactive)
            if ok then canMove = active end
        end
        if canMove then
            local target = GetClosestTarget()
            if target then
                local sp = Camera:WorldToViewportPoint(target.Position)
                local dx = sp.X - mouse.X
                local dy = sp.Y - mouse.Y
                local s = StrengthToSmooth(Config.Aimbot.Strength)
                local mx, my
                if s <= 1.01 then
                    mx, my = math.round(dx), math.round(dy)
                else
                    mx, my = math.round(dx / s), math.round(dy / s)
                end
                if mx ~= 0 or my ~= 0 then
                    pcall(mousemoverel, mx, my)
                end
            end
        end
    end
end))

