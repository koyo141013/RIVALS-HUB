-- 뷰모델/핫바/툴에서 장착 무기명 반환 (플레이어별)
local function GetPlayerWeaponName(plr)
    local pname = plr.Name
    local prefix = pname .. " - "
    local vms = nil
    pcall(function() vms = Workspace:FindFirstChild("ViewModels") end)
    if vms then
        local models = {}
        for _, folder in ipairs(vms:GetChildren()) do
            if folder:IsA("Model") then
                table.insert(models, folder)
            else
                pcall(function()
                    for _, m in ipairs(folder:GetChildren()) do
                        if m:IsA("Model") then table.insert(models, m) end
                    end
                end)
            end
        end
        for _, m in ipairs(models) do
            if string.sub(m.Name, 1, #prefix) == prefix then
                for _, w in ipairs(GetKnownWeaponNames()) do
                    if string.find(m.Name, w, 1, true) then return w end
                end
                local rest = string.sub(m.Name, #prefix + 1)
                local dash = string.find(rest, "%s%-%s")
                local first = dash and string.sub(rest, 1, dash - 1) or rest
                first = string.match(first, "^%s*(.-)%s*$")
                if first ~= "" then return first end
            end
        end
    end
    if plr == LocalPlayer then
        pcall(function()
            local hotbar = LocalPlayer.PlayerGui.MainGui.MainFrame.FighterInterfaces[pname].BottomCenter.Container.Hotbar.Container
            if not hotbar then return end
            local counts, slots = {}, {}
            for _, slot in ipairs(hotbar:GetChildren()) do
                if slot:IsA("Frame") and slot.Name ~= "EquippedDisplay" and not string.find(slot.Name, "Keybind") then
                    local bg = slot:FindFirstChild("Background")
                    local img = (bg and bg:IsA("ImageLabel")) and bg.Image or ""
                    counts[img] = (counts[img] or 0) + 1
                    table.insert(slots, { name = slot.Name, img = img })
                end
            end
            for _, s in ipairs(slots) do
                if counts[s.img] == 1 then return s.name end
            end
        end)
    end
    local char = plr.Character
    if char then
        local tool = char:FindFirstChildWhichIsA("Tool")
        if tool then return tool.Name end
    end
    return nil
end

local HasBlockedWeapon = function(plr)
    local w = GetPlayerWeaponName(plr)
    return w ~= nil and BLOCKED_WEAPONS[NormalizeKey(w)] == true
end

-- ============ 에임봇 타겟 (방패/카타나 필터)
local function GetClosestTarget()
    if not Config.Aimbot.Enabled then return nil end
    local mouse = UserInputService:GetMouseLocation()
    local best, bestDist = nil, Config.Aimbot.FOV
    local myChar = LocalPlayer.Character
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Config.Aimbot.TeamCheck and IsTeammate(plr) then continue end
        local char = GetCharacter(plr)
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not IsAlive(plr, char, hum) then continue end
        if HasBlockedWeapon(plr) then continue end
        local part = GetTargetPart(char)
        if not part then continue end
        if (Camera.CFrame.Position - part.Position).Magnitude > Config.Aimbot.MaxDistance then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist2d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
        if dist2d > bestDist then continue end
        if Config.Aimbot.WallCheck and myChar then
            if HasWallBetween(Camera.CFrame.Position, part.Position, { myChar, char, Camera }) then continue end
        end
        best, bestDist = part, dist2d
    end
    return best
end

