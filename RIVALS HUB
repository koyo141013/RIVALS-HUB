    FOVCircle.Visible = Config.Aimbot.Enabled and not MenuOpen
    FOVOutline.Visible = Config.Aimbot.Enabled and not MenuOpen

    -- 사일런트 FOV (메인 루프에서 직접 구동)
    do
        local sc, so = env._silentFOVCircle, env._silentFOVOutline
        -- 원이 없으면 다시 생성 (Drawing 미지원/해제 환경 대비)
        if not sc then
            pcall(function()
                sc = Drawing.new("Circle")
                sc.Color = Color3.fromRGB(255, 255, 255)
                sc.Thickness = 1.5
                sc.NumSides = 64
                sc.Filled = false
                sc.Transparency = 1
                sc.Visible = false
                env._silentFOVCircle = sc
            end)
        end
        if not so then
            pcall(function()
                so = Drawing.new("Circle")
                so.Color = Color3.fromRGB(0, 0, 0)
                so.Thickness = 3
                so.NumSides = 64
                so.Filled = false
                so.Transparency = 0.4
                so.Visible = false
                env._silentFOVOutline = so
            end)
        end
        local svis = S.silentAimOn and S.silentShowFOV
        local sr = tonumber(S.silentAimFOV) or 350
        if sc then
            sc.Position = mouse
            sc.Radius = sr
            sc.Visible = svis
        end
        if so then
            so.Position = mouse
            so.Radius = sr
            so.Visible = svis
        end
    end

    if Config.Walk.Enabled then
        local ch = LocalPlayer.Character
        local hh = ch and ch:FindFirstChildOfClass("Humanoid")
        if hh then
            pcall(function() hh.WalkSpeed = math.max(Config.Walk.Speed, DEFAULT_WALK) end)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        local ok, err = pcall(UpdateESPPlayer, plr, viewportSize)
        if not ok then warn(err) end
    end
    for plr, objs in pairs(ESPObjects) do
        if not plr.Parent then
            HideESP(objs)
            ESPObjects[plr] = nil
            local hl = EspChams[plr]
            if hl then pcall(function() hl:Destroy() end) EspChams[plr] = nil end
        end
    end

    if Config.Aimbot.Enabled and not MenuOpen then
        local canMove = true
        if typeof(iswindowactive) == "function" then
            local ok, active = pcall(iswindowactive)
            if ok then canMove = active end
        end
        if canMove then
            local target = GetClosestTarget()
            if target then
                local sp = Camera:WorldToViewportPoint(target.Position)
                local dx = sp.X - mouse.X
                local dy = sp.Y - mouse.Y
                local s = StrengthToSmooth(Config.Aimbot.Strength)
                local mx, my
                if s <= 1.01 then
                    mx, my = math.round(dx), math.round(dy)
                else
                    mx, my = math.round(dx / s), math.round(dy / s)
                end
                if mx ~= 0 or my ~= 0 then
                    pcall(mousemoverel, mx, my)
                end
            end
        end
    end
end))

table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    local ok, err = pcall(FlyStep)
    if not ok then warn(err) end
    local ok2, err2 = pcall(WalkStep, dt)
    if not ok2 then warn(err2) end
    local ok3, err3 = pcall(NoclipStep)
    if not ok3 then warn(err3) end
    -- RagebotStep: AntiEnhancement Controller 사용 (Heartbeat 직접발사 비활성)
    local ok5, err5 = pcall(TriggerBotStep)
    if not ok5 then warn(err5) end
    -- 레이지봇 자동 발사: 메뉴 닫힘 + 선택창 닫힘 상태에서만 Fire Rate 간격으로 클릭 (타깃 무관)
    local okR, errR = pcall(function()
        if S.ragebotOn and not MenuOpen and not IsPickWeaponsOpen() and env._clickFn then
            local C = getgenv().__s9t0u1
            if C and C.__active and C.__target and C.__target.Character then
                local fire = true
                if S.ragebotResolver then
                    fire = ResolveShotSafe(C.__target.Character)
                end
                if fire then
                    local now = os.clock()
                    local fr = math.max(tonumber(S.ragebotFireRate) or 0.05, 0.05)
                    if now - (env._rageAutoLast or 0) >= fr then
                        -- 카메라를 타겟 방향으로 조준 (정확도 향상)
                        local cam = Workspace.CurrentCamera
                        local targetChar = C.__target.Character
                        local targetHead = targetChar and (targetChar:FindFirstChild("HitboxHead") or targetChar:FindFirstChild("Head"))
                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if cam and targetHead and myRoot then
                            local targetPos = targetHead.Position
                            local myPos = myRoot.Position
                            local dir = (targetPos - myPos).Unit
                            local camCF = cam.CFrame
                            local lookDir = camCF.LookVector
                            local dot = dir:Dot(lookDir)
                            -- 타겟이 카메라 시야 밖에 있으면 조준 조정
                            if dot < 0.95 then
                                local newCF = CFrame.lookAt(myPos, targetPos)
                                pcall(function()
                                    cam.CFrame = newCF
                                end)
                            end
                        end
                        env._rageAutoLast = now
                        env._clickFn()
                    end
                end
            end
        end
    end)
    if not okR then warn(errR) end
    local ok6, err6 = pcall(EvasionStep)
    if not ok6 then warn(err6) end
end))

