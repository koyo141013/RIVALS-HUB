local function ApplySkybox(name)
    local preset = SKY_PRESETS[name]
    if not preset then return false end
    local ok, Lighting = pcall(function() return game:GetService("Lighting") end)
    if not ok or not Lighting then return false end
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        local ok2, ns = pcall(function()
            local s = Instance.new("Sky")
            s.Parent = Lighting
            return s
        end)
        if not ok2 or not ns then return false end
        sky = ns
        SkyState.created = true
    else
        if not SkyState.orig then
            SkyState.orig = {}
            for _, k in ipairs({"SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp",
                "StarCount", "SunAngularSize", "MoonAngularSize", "MoonTextureId", "SunTextureId", "CelestialBodiesShown"}) do
                pcall(function() SkyState.orig[k] = sky[k] end)
            end
        end
        SkyState.created = false
    end
    for k, v in pairs(preset) do
        pcall(function() sky[k] = v end)
    end
    pcall(function() sky.CelestialBodiesShown = true end)
    return true
end
local function RestoreSky()
    pcall(function()
        local Lighting = game:GetService("Lighting")
        if SkyState.created then
            local s = Lighting:FindFirstChildOfClass("Sky")
            if s then s:Destroy() end
        elseif SkyState.orig then
            local s = Lighting:FindFirstChildOfClass("Sky")
            if s then
                for k, v in pairs(SkyState.orig) do
                    pcall(function() s[k] = v end)
                end
            end
        end
    end)
    SkyState.orig = nil
    SkyState.created = nil
end

-- ============ Drawing / ESP state ============
local Holding = false
local ESPObjects = {}
local Connections = {}
local FOVCircle, FOVOutline = nil, nil
local GuiObjects = {}
local FlyParts = {}
local function DisconnectAll()
    for _, o in ipairs(FlyParts) do pcall(function() o:Destroy() end) end
    table.clear(FlyParts)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
            -- 정상 캐릭터 기본값은 전부 CanCollide=false (true로 두면 지면과 겹쳐 위로 튕김)
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    table.clear(Connections)
    for _, objs in pairs(ESPObjects) do
        for _, d in pairs(objs) do
            if type(d) == "table" and d.Visible == nil then
                for _, ln in ipairs(d) do pcall(function() ln:Remove() end) end
            else
                pcall(function() d:Remove() end)
            end
        end
    end
    table.clear(ESPObjects)
    for _, hl in pairs(EspChams) do pcall(function() hl:Destroy() end) end
    table.clear(EspChams)
    pcall(function() if FOVCircle and FOVCircle.Remove then FOVCircle:Remove() end end)
    pcall(function() if FOVOutline and FOVOutline.Remove then FOVOutline:Remove() end end)
