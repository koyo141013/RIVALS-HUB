env._installSkinViewModels = function()
    if SkinState.VMReady and SkinState.VMVersion == HUB_VERSION then return true end
    local ok, err = pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts") or LocalPlayer:WaitForChild("PlayerScripts", 5)
        if not ps then error("PlayerScripts missing") end
        local mods = ps:FindFirstChild("Modules")
        if not mods then error("PlayerScripts.Modules missing") end
        local crc = mods:FindFirstChild("ClientReplicatedClasses")
        local cf = crc and crc:FindFirstChild("ClientFighter")
        local ciMod = cf and cf:FindFirstChild("ClientItem")
        local citem = nil
        if ciMod then pcall(function() citem = reqGame(ciMod) end) end

        if citem and citem._CreateViewModel and not SkinState.VM_CVMHooked then
            local ocvm = citem._CreateViewModel
            citem._CreateViewModel = function(self, vmref)
                if SkinState.vmDisabled then return ocvm(self, vmref) end
                if self == nil then return ocvm(self, vmref) end
                local wname = self.Name
                local wplr = self.ClientFighter and self.ClientFighter.Player
                cwep = (wplr == LocalPlayer) and wname or nil
                local directClass
                if wplr == LocalPlayer and not SkinState.pickPageOpen and SkinState.equip[wname] and type(vmref) == "table" and type(self.ToEnum) == "function" then
                    local cos = SkinState.equip[wname]
                    local dk = self:ToEnum("Data")
                    local data = vmref[dk] or vmref.Data or {}
                    if data then
                        if vmref[dk] ~= nil or vmref.Data == nil then
                            vmref[dk] = data
                            vmref.Data = nil
                        else
                            vmref.Data = data
                        end
                        local resolvedName = resolveViewModelName(wname, cos)
                        local className = resolveViewModelClassName(wname, cos, resolvedName)
                        if cos.Skin then
                            data[self:ToEnum("Skin")] = cos.Skin
                        end
                        data[self:ToEnum("Name")] = resolvedName
                        if cos.Wrap then
                            data[self:ToEnum("Wrap")] = cos.Wrap
                        end
                        if cos.Charm then
                            data[self:ToEnum("Charm")] = cos.Charm
                        end
                        data.Skin = nil
                        data.Name = nil
                        data.Wrap = nil
                        data.Charm = nil
                        if className ~= resolvedName and resolveViewModelClass then
                            directClass = resolveViewModelClass(className)
                        end
                    end
                end
                local res = ocvm(self, vmref)
                cwep = nil
                applyLiveFistsMeshProfile(wname, res)
                return res
            end
            SkinState.VM_CVMHooked = true
        end

        local vmmod = cf and cf:FindFirstChild("ClientItem")
        vmmod = vmmod and vmmod:FindFirstChild("ClientViewModel")
        if vmmod and not SkinState.VM_NEWHooked then
            local cvm = reqGame(vmmod)
            if type(cvm) ~= "table" or type(cvm.new) ~= "function" then
                error("ClientViewModel.new missing")
            end
            clientViewModelClass = cvm
            local onew = cvm.new
            clientViewModelBaseNew = onew
            cvm.new = function(rdata, cliitm)
                if SkinState.vmDisabled then return onew(rdata, cliitm) end
                if cliitm == nil then return onew(rdata, cliitm) end
                if constructingVirtualViewModelClass then
                    return onew(rdata, cliitm)
                end
                local wplr = cliitm.ClientFighter and cliitm.ClientFighter.Player
                local wname = cwep or cliitm.Name
                local className = wname
                if wplr == LocalPlayer and not SkinState.pickPageOpen and SkinState.equip[wname] then
                    local rcls = reqGame(ReplicatedStorage.Modules.ReplicatedClass)
                    if rcls == nil then return onew(rdata, cliitm) end
                    local dk = rcls:ToEnum("Data")
                    local slot = rdata[dk] or rdata.Data or {}
                    if rdata[dk] ~= nil or rdata.Data == nil then
                        rdata[dk] = slot
                        rdata.Data = nil
                    else
                        rdata.Data = slot
                    end
                    local cos = SkinState.equip[wname]
                    local resolvedName = resolveViewModelName(wname, cos)
                    className = resolveViewModelClassName(wname, cos, resolvedName)
                    if cos.Skin then
                        slot[rcls:ToEnum("Skin")] = cos.Skin
                    end
                    slot[rcls:ToEnum("Name")] = resolvedName
                    if cos.Wrap then
                        slot[rcls:ToEnum("Wrap")] = cos.Wrap
                    end
                    if cos.Charm then
                        slot[rcls:ToEnum("Charm")] = cos.Charm
                    end
                    slot.Skin = nil
                    slot.Name = nil
                    slot.Wrap = nil
                    slot.Charm = nil
                end
                local targetNew = onew -- class replace removed (AntiEnhancement lesson)
                constructingVirtualViewModelClass = targetNew ~= onew
                local ok2, res = pcall(targetNew, rdata, cliitm)
                constructingVirtualViewModelClass = false
                if not ok2 then return nil end
                if wplr == LocalPlayer and SkinState.equip[wname] and res then
                    for _, method in ipairs({"_UpdateWrap", "UpdateWrap", "_UpdateCharm", "UpdateCharm", "_UpdateCosmetics", "UpdateCosmetics"}) do
                        if res[method] then
                            pcall(res[method], res)
                        end
                    end
                    applyLiveFistsMeshProfile(wname, res)
                end
                return res
            end
            SkinState.VM_NEWHooked = true
        end

        local ilibVM = nil
        pcall(function()
            local rm = ReplicatedStorage:FindFirstChild("Modules")
            local im = rm and (rm:FindFirstChild("ItemLibrary") or rm.ItemLibrary)
            if im then ilibVM = reqGame(im) end
        end)
        if ilibVM then SkinState.ilibVM = ilibVM end
        if ilibVM and type(ilibVM.GetViewModelImageFromWeaponData) == "function" and not SkinState.VM_IMGHooked then
            local ogvi = ilibVM.GetViewModelImageFromWeaponData
            ilibVM.GetViewModelImageFromWeaponData = function(self, wdata, hires)
                if SkinState.vmDisabled then return ogvi(self, wdata, hires) end
                if not wdata then return ogvi(self, wdata, hires) end
                local wname = wdata.Name
                local weq = SkinState.equip[wname]
                if weq and weq.Skin and not SkinState.pickPageOpen then
                    local skinViewModelName = weq.Skin.ViewModelName or weq.Skin.Name
                    local skinSourceName = weq.Skin.SourceViewModelName or skinViewModelName
                    local sinfo = self.ViewModels[skinViewModelName] or self.ViewModels[skinSourceName]
                    if sinfo then return sinfo[hires and "ImageHighResolution" or "Image"] or sinfo.Image end
                    return weq.Skin[hires and "ImageHighResolution" or "Image"] or weq.Skin.Image or ""
                end
                return ogvi(self, wdata, hires)
            end
            SkinState.VM_IMGHooked = true
            SkinState.ilibVM = ilibVM
        end

        if not (SkinState.VM_CVMHooked or SkinState.VM_NEWHooked or SkinState.VM_IMGHooked) then
            error("no VM hooks installed")
        end
        SkinState.VMReady = true
        SkinState.VMVersion = HUB_VERSION
    end)
    if not ok then
        SkinState.VMLastError = err
        warn("[SkinVM] install failed:", err)
        return false
    end
    print("[SkinVM] viewmodel hooks ready")
    return true
end

