local function buildManipulationCameraData(fromPos, part)
    if not SA_MOD.u or not part then return nil end
    local aimPosition = part.Position
    pcall(function()
        -- HRP 속도 기준 예측 (헤드 파트 속도보다 안정적) + 핑 보정
        local char = part.Parent
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local vel = (hrp and hrp.AssemblyLinearVelocity)
            or part.AssemblyLinearVelocity or part.Velocity
        if typeof(vel) == "Vector3" and vel.Magnitude > 1 then
            local ping = 0
            pcall(function() ping = tonumber(LocalPlayer:GetNetworkPing()) or 0 end)
            local lead = math.clamp(vel.Magnitude / 350, 0, 0.12) + math.clamp(ping or 0, 0, 0.25)
            aimPosition = part.Position + vel * lead
        end
    end)
    local look = CFrame.new(fromPos, aimPosition)
    local data = {}
    data[utf8.char(1)] = {
        [utf8.char(0)] = SA_MOD.u:EncodeCFrame(look),
        [utf8.char(1)] = SA_MOD.u:EncodeCFrame(look),
        [utf8.char(2)] = part,
        [utf8.char(3)] = SA_MOD.u:EncodeCFrame(part.CFrame:ToObjectSpace(CFrame.new(aimPosition))),
    }
    return data
end

local function saInstallHook()
    if SA_H.installed then return true end
    if not saEnsureModules() then return false end
    local useItem = saGetUseItemRemote()
    if not useItem then return false end
    if type(hookfunction) ~= "function" then return false end
    local startShoot = nil
    pcall(function()
        startShoot = SA_MOD.e:ToEnum("StartShooting")
    end)
    -- enum 직접비교 + 문자열 폴백 (ToEnum 실패/타입 불일치 대비)
    local function isStartShooting(action)
        if startShoot ~= nil and action == startShoot then return true end
        local ok, s = pcall(tostring, action)
        if ok and type(s) == "string" then
            if s == "StartShooting" or string.find(s, "StartShooting", 1, true) then return true end
        end
        return false
    end
    local ok, err = pcall(function()
        local old
        local fn = function(self, obj, action, cameradata, ...)
            SA_D.shots += 1
            env._saShots = SA_D.shots
            if S.silentAimOn and not MenuOpen and isStartShooting(action) then
                local target, part = saGetTarget()
                if target and part and target:FindFirstChild("HumanoidRootPart") then
                    local cam = Workspace.CurrentCamera
                    local fromPos = (cam and cam.CFrame.Position) or part.Position
                    -- CFrame.new(동일 좌표) 등 내부 에러가 발사 자체를 깨지 않게 격리
                    local newData = nil
                    pcall(function() newData = buildManipulationCameraData(fromPos, part) end)
                    if newData then
                        SA_D.hits += 1
                        env._saHits = SA_D.hits
                        _saStatusTick(false)
                        return old(self, obj, action, newData, ...)
                    end
                end
            end
            if SA_D.shots % 20 == 0 then _saStatusTick(false) end
            return old(self, obj, action, cameradata, ...)
        end
        if type(newcclosure) == "function" then
            local okcc, cc = pcall(newcclosure, fn)
            if okcc and cc then fn = cc end
        end
        old = hookfunction(useItem.FireServer, fn)
        SA_H.old = old
        regRestore(function()
            pcall(function() hookfunction(useItem.FireServer, old) end)
        end)
    end)
    if ok then
        SA_H.installed = true
        _saStatusTick(true)
        return true
    end
    warn("[Silent Aim] hook failed:", err)
    _saStatusTick(true)
    return false
end

