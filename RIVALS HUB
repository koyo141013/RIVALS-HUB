    A = { [utf8.char(0)] = -9e37, [utf8.char(1)] = 0, [utf8.char(2)] = 0, [utf8.char(3)] = -1.5707963267948966, [utf8.char(4)] = 3.1415926535897931, [utf8.char(5)] = 3.1415926535897931 },
