                            local t = saTarget2()
                            if root and t then
                                local nd = saCFD(root.Position, t)
                                if nd then camdata = nd end
                            end
                        end
                    end
                    return hookPrev(self, objID, enumVal, camdata, extra)
                end
                if type(newcclosure) == "function" then
                    local okcc, cc = pcall(newcclosure, fn)
                    if okcc and cc then fn = cc end
                end
                hookfunction(useItem.FireServer, fn)
            end)
            if okH then
                _saUseHooked = true
                regRestore(function()
                    pcall(function() hookfunction(useItem.FireServer, hookPrev) end)
                end)
            end
        end
    end
    if not env._silentFOVBuilt then
        pcall(function()
            if getgenv().RivalsSilentFOVConn then getgenv().RivalsSilentFOVConn:Disconnect() end
        end)
        local okC, circ = pcall(function()
            local c = Drawing.new("Circle")
