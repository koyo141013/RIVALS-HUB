-- ============ Rank (Kicia RankTracker 이식: DisplayELO → SeasonLibrary RankProfile → 랭크명) ============
local _rankProfileCache = nil
local _rankProfileTick = 0
local function GetRankProfile()
    local now = os.clock()
    if _rankProfileCache and (now - _rankProfileTick) < 30 then return _rankProfileCache end
    local prof = nil
    pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        local slm = mods and mods:FindFirstChild("SeasonLibrary")
        if not slm then return end
        local lib = require(slm)
        local season = lib and lib.CurrentSeason
        local rpName = season and season.RankProfile and season.RankProfile.Name
        local profiles = lib and lib.RankProfiles
        local p = rpName and profiles and profiles[rpName]
        if p and p.RanksOrder and p.Ranks then
            prof = { order = p.RanksOrder, ranks = p.Ranks }
        end
    end)
    if prof then _rankProfileCache, _rankProfileTick = prof, now end
    return _rankProfileCache
end

local function EloToRankName(elo)
    if elo == nil then return "Unranked" end
    local prof = GetRankProfile()
    if not prof then return tostring(elo) end
    local ok, name = pcall(function()
        local order, ranks = prof.order, prof.ranks
        local n = #order
        for k, rname in ipairs(order) do
            local r = ranks[rname]
            if r ~= nil then
                if elo < r.RequiredELO and r.RequiredELOLeaderboardRanking == nil then
                    return order[math.clamp(k - 1, 1, n)]
                end
            end
        end
        for i = n, 1, -1 do
            local rname = order[i]
            if rname ~= nil then
                local r = ranks[rname]
                if r ~= nil and r.RequiredELOLeaderboardRanking == nil then
                    return rname
                end
            end
        end
        return "Unranked"
    end)
    if ok and type(name) == "string" then return name end
    return tostring(elo)
end

