    if not S.triggerBotOn or MenuOpen then return end
    local now = os.clock()
    if now - _triggerLastShot < 0.1 then return end
    local target = getBestTarget(S.silentAimFOV)
    if not target then return end
    if target.Parent and not ResolveShotSafe(target.Parent) then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local pos, vis = cam:WorldToViewportPoint(target.Position)
    if not vis then return end
    local mouse = UserInputService:GetMouseLocation()
    local dx = pos.X - mouse.X
    local dy = pos.Y - mouse.Y
    local dist = math.sqrt(dx * dx + dy * dy)
    if dist > 10 then return end
    _triggerLastShot = now
    pcall(mouse1click)
end

