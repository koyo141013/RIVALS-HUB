-- ============ Game helpers ============
local function GetCharacter(player)
    return player.Character
end

local function IsAlive(player, char, humanoid)
    if not Config.Aimbot.AliveCheck then return true end
    char = char or GetCharacter(player)
    if not char then return false end
    humanoid = humanoid or char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return humanoid.Health > 0
end

local function IsTeammate(player)
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return true
    end
    return false
end

local function HasWallBetween(origin, targetPos, ignoreList)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignoreList
    params.IgnoreWater = true
    return Workspace:Raycast(origin, targetPos - origin, params) ~= nil
end

local function GetTargetPart(char)
    if Config.Aimbot.TargetPart == "Closest" then
        local head = char:FindFirstChild("Head")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not head then return hrp end
        if not hrp then return head end
        local mouse = UserInputService:GetMouseLocation()
        local hp, hov = Camera:WorldToViewportPoint(head.Position)
        local rp, rov = Camera:WorldToViewportPoint(hrp.Position)
        if not hov then return hrp end
        if not rov then return head end
        local hd = (Vector2.new(hp.X, hp.Y) - mouse).Magnitude
        local rd = (Vector2.new(rp.X, rp.Y) - mouse).Magnitude
        return (hd < rd) and head or hrp
    end
    return char:FindFirstChild(Config.Aimbot.TargetPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

