table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Config.Aimbot.HoldKey then
        Holding = true
    elseif input.KeyCode == Enum.KeyCode.PageUp then
        Config.Aimbot.FOV = math.clamp(Config.Aimbot.FOV + 10, 20, 400)
        if FOVCircle then FOVCircle.Radius = Config.Aimbot.FOV end
        if FOVOutline then FOVOutline.Radius = Config.Aimbot.FOV end
        pcall(function() Options.RIV_FOV:SetValue(Config.Aimbot.FOV) end)
    elseif input.KeyCode == Enum.KeyCode.PageDown then
        Config.Aimbot.FOV = math.clamp(Config.Aimbot.FOV - 10, 20, 400)
        if FOVCircle then FOVCircle.Radius = Config.Aimbot.FOV end
        if FOVOutline then FOVOutline.Radius = Config.Aimbot.FOV end
        pcall(function() Options.RIV_FOV:SetValue(Config.Aimbot.FOV) end)
    end
end))
table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Config.Aimbot.HoldKey then
        Holding = false
    end
end))

