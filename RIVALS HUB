    for i = 1, select("#", ...) do
        parts[i] = tostring(select(i, ...))
    end
    local line = os.date("%X") .. " " .. table.concat(parts, " ")
    table.insert(SkinState.log, line)
    if #SkinState.log > 200 then table.remove(SkinState.log, 1) end
    print("[SkinLog]", line)
end

local function reqGame(mod)
    if mod == nil then return nil end
    local id = nil
    pcall(function()
        if getthreadidentity then id = getthreadidentity() end
    end)
    if setthreadidentity then pcall(setthreadidentity, 2) end
    local ok, res = pcall(require, mod)
    if id and setthreadidentity then pcall(setthreadidentity, id) end
    if ok then return res end
    return nil
end

local function safe_cc(fn)
    if type(newcclosure) == "function" then
        local ok, r = pcall(newcclosure, fn)
        if ok and r then return r end
    end
    return fn
end

