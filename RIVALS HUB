local function getBestTarget(fovLimit)
    local currentCam = Workspace.CurrentCamera or Workspace:FindFirstChildOfClass("Camera")
    if not currentCam then return nil end
    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget = nil
    local shortestDist = fovLimit or 150
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head and head:IsA("BasePart") then
                local ok, screenPos, onScreen = pcall(function()
                    return currentCam:WorldToViewportPoint(head.Position)
                end)
                if ok and onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTarget = head
                    end
                end
            end
        end
    end
    return bestTarget
end

local function RagebotStep()
    if not S.ragebotOn or MenuOpen then return end
    local target = getBestTarget(S.silentAimFOV)
    if not target then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local pos, vis = cam:WorldToViewportPoint(target.Position)
    if not vis then return end
    local mouse = UserInputService:GetMouseLocation()
    local dx = pos.X - mouse.X
    local dy = pos.Y - mouse.Y
    local sens = S.ragebotStability
    pcall(mousemoverel, math.round(dx * sens), math.round(dy * sens))
end

