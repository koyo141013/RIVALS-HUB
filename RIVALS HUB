-- 카메라를 움직이지 않고 발사 데이터를 타겟 쪽으로 교체
local _saUtil, _saEnums = nil, nil
local _saOldFireServer = nil
local _saHookInstalled = false
local _saTargetPart = nil

function _playerHoldingKatana(plr)
    if not plr or not plr.Character then return false end
    local c = plr.Character
    local tool = c:FindFirstChildOfClass("Tool")
    if tool and string.find(string.lower(tool.Name), "katana", 1, true) then return true end
    return false
end

local function saGetTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil, nil end
    local fov = tonumber(S.silentAimFOV) or 350
    local mouseLoc = UserInputService:GetMouseLocation()
    local center = Vector2.new(mouseLoc.X, mouseLoc.Y)
    local bestChar, bestPart, bestDist = nil, nil, fov
    local prefer = S.silentAimHitPart or "Head"
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if not (S.antiKatanaOn and _playerHoldingKatana(plr)) then
                local char = plr.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = nil
                    if prefer == "Body" then
                        part = char:FindFirstChild("HitboxBody")
                            or char:FindFirstChild("UpperTorso")
                            or char:FindFirstChild("HumanoidRootPart")
                            or char:FindFirstChild("HitboxHead")
                            or char:FindFirstChild("Head")
                    else
                        part = char:FindFirstChild("HitboxHead")
                            or char:FindFirstChild("Head")
                            or char:FindFirstChild("HitboxBody")
                            or char:FindFirstChild("HumanoidRootPart")
                    end
                    if part then
                        local ok, pos, vis = pcall(function()
                            return cam:WorldToViewportPoint(part.Position)
                        end)
                        if ok and vis then
                            local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if d < bestDist then
                                bestDist = d
                                bestChar = char
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
    end
    _saTargetPart = bestPart
    env._silentAimTarget = bestPart
    return bestChar, bestPart
end

local function saEnsureModules()
    if _saUtil and _saEnums then return true end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    if not modules then return false end
    local u = modules:FindFirstChild("Utility")
    local e = modules:FindFirstChild("EnumLibrary")
    if not u or not e then return false end
    local okU, util = pcall(require, u)
    local okE, enums = pcall(require, e)
    if okU then _saUtil = util end
    if okE then _saEnums = enums end
    return _saUtil ~= nil and _saEnums ~= nil
end

local function saGetUseItemRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return nil end
    local replication = remotes:FindFirstChild("Replication")
    if not replication then return nil end
    local fighter = replication:FindFirstChild("Fighter")
    if not fighter then return nil end
    local useItem = fighter:FindFirstChild("UseItem")
    if useItem and useItem:IsA("RemoteEvent") then
        return useItem
    end
    return nil
end

local function buildManipulationCameraData(fromPos, part)
    if not _saUtil or not part then return nil end
    local aimPosition = part.Position
    pcall(function()
        local vel = part.AssemblyLinearVelocity or part.Velocity
        if typeof(vel) == "Vector3" and vel.Magnitude > 1 then
            local lead = math.clamp(vel.Magnitude / 350, 0, 0.12)
            aimPosition = part.Position + vel * lead
        end
    end)
    local look = CFrame.new(fromPos, aimPosition)
    local data = {}
    data[utf8.char(1)] = {
        [utf8.char(0)] = _saUtil:EncodeCFrame(look),
        [utf8.char(1)] = _saUtil:EncodeCFrame(look),
        [utf8.char(2)] = part,
        [utf8.char(3)] = _saUtil:EncodeCFrame(part.CFrame:ToObjectSpace(CFrame.new(aimPosition))),
    }
    return data
end

local function saInstallHook()
    if _saHookInstalled then return true end
    if not saEnsureModules() then return false end
    local useItem = saGetUseItemRemote()
    if not useItem then return false end
    if type(hookfunction) ~= "function" then return false end
    local startShoot = nil
    pcall(function()
        startShoot = _saEnums:ToEnum("StartShooting")
    end)
    local ok, err = pcall(function()
        local old
        local fn = function(self, obj, action, cameradata, ...)
            if S.silentAimOn and not MenuOpen and action == startShoot then
                local target, part = saGetTarget()
                if target and part and target:FindFirstChild("HumanoidRootPart") then
                    local cam = Workspace.CurrentCamera
                    local fromPos = (cam and cam.CFrame.Position) or part.Position
                    local newData = buildManipulationCameraData(fromPos, part)
                    if newData then
                        return old(self, obj, action, newData, ...)
                    end
                end
            end
            return old(self, obj, action, cameradata, ...)
        end
        if type(newcclosure) == "function" then
            local okcc, cc = pcall(newcclosure, fn)
            if okcc and cc then fn = cc end
        end
        old = hookfunction(useItem.FireServer, fn)
        _saOldFireServer = old
        regRestore(function()
            pcall(function() hookfunction(useItem.FireServer, old) end)
        end)
    end)
    if ok then
        _saHookInstalled = true
        return true
    end
    warn("[Silent Aim] hook failed:", err)
    return false
end

task.spawn(function()
    for _ = 1, 60 do
