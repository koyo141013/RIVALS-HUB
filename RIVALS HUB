                                    if type(w.Get) == "function" then wn = w:Get("Name") or wn end
                                end)
                                if wn == wname then orig = w break end
                            end
                        end
                    end
                end
            end)
            return orig
        end

        if renameInfo then
            local okR = pcall(function()
                rawset(dctrl, "GetWeaponData\0ohaio", safe_cc(function(self, wname, ...)
                    _hookDepth += 1
                    if _hookDepth > 3 then _hookDepth -= 1 return nil end
                    local res = nil
                    local orig = fetchOriginal(wname)
                    if type(orig) == "table" then
                        res = mergeWeaponData(wname, orig)
                    else
                        local data = nil
                        local args = table.pack(...)
                        local okC = pcall(function()
                            debug.setconstant(renameInfo.fn, renameInfo.idx, "GetWeaponData")
                            data = getWD(self, wname, table.unpack(args, 1, args.n))
                            debug.setconstant(renameInfo.fn, renameInfo.idx, "GetWeaponData\0ohaio")
                        end)
                        if not okC then
                            pcall(function() debug.setconstant(renameInfo.fn, renameInfo.idx, "GetWeaponData\0ohaio") end)
                        end
                        res = mergeWeaponData(wname, data)
                    end
                    _hookDepth -= 1
                    return res
                end))
            end)
            if okR then
                SkinState.HookLayers.rename = true
            else
                revertRename()
            end
        end

        -- liveMergeTest는 위쪽 Lion 섹션으로 이동됨

        -- 리네임 검증: pass가 아니면 무조건 원복 후 폴백으로
        if SkinState.HookLayers.rename then
            local verdict = liveMergeTest()
            SkinState.RenameVerdict = verdict
            if verdict ~= "pass" then
                revertRename()
                SkinState.HookLayers.rename = false
            end
        end

        -- Layer H/T 폴백 (리네임이 없을 때만)
        if not SkinState.HookLayers.lion and not SkinState.WDHooked then
            local installed = false
            if type(hookfunction) == "function" then
                pcall(function()
                    local oldWD = getWD
                    local hooked = safe_cc(function(self, wname, ...)
                        if SkinState.hooksDisabled then return oldWD(self, wname, ...) end
                        if not SkinState.dataHooks then return oldWD(self, wname, ...) end
                        if SkinState.pickPageOpen then return oldWD(self, wname, ...) end
                        local data = oldWD(self, wname, ...)
                        return mergeWeaponData(wname, data)
                    end)
                    local okH, res = pcall(hookfunction, getWD, hooked)
                    if okH and res then installed = true end
                end)
                if installed then SkinState.HookLayers.hookfunction = true end
            end
            if not installed then
                pcall(function()
                    local mt = getmetatable(dctrl)
                    local idx = (type(mt) == "table") and rawget(mt, "__index") or nil
                    local oldWD = getWD
                    local hooked = safe_cc(function(self, wname, ...)
                        if SkinState.hooksDisabled then return oldWD(self, wname, ...) end
                        if not SkinState.dataHooks then return oldWD(self, wname, ...) end
                        if SkinState.pickPageOpen then return oldWD(self, wname, ...) end
                        local data = oldWD(self, wname, ...)
                        return mergeWeaponData(wname, data)
                    end)
                    if type(idx) == "table" and rawget(idx, "GetWeaponData") == getWD then
                        rawset(idx, "GetWeaponData", hooked)
                        installed = true
                    elseif type(dctrl.GetWeaponData) == "function" then
                        rawset(dctrl, "GetWeaponData", hooked)
                        installed = true
                    end
                end)
                if installed then SkinState.HookLayers.rawset = true end
            end
            SkinState.WDHooked = installed
            if installed then
                SkinState.FallbackVerdict = liveMergeTest()
            end
        end

        if not (SkinState.HookLayers.lion or SkinState.HookLayers.rename or SkinState.HookLayers.hookfunction or SkinState.HookLayers.rawset) then
            error("GetWeaponData hook failed (all layers)")
        end

        local function applyCosmeticToWeapon(weapon, cosmeticName, ctype)
            ctype = ctype or "Skin"
            if ctype ~= "Skin" and ctype ~= "Wrap" and ctype ~= "Charm" and ctype ~= "Finisher" then
                ctype = "Skin"
            end
            if type(weapon) ~= "string" or weapon == "" then return false end
            equip[weapon] = equip[weapon] or {}
            if not cosmeticName or cosmeticName == "" or cosmeticName == "None" or cosmeticName == NONE then
                equip[weapon][ctype] = nil
                if equip[weapon] and not next(equip[weapon]) then equip[weapon] = nil end
            else
                local target = cosmeticName
                if target == RANDOM or target == "Random" then
                    target = randomCosmetic(ctype, weapon)
                    if not target then
                        equip[weapon][ctype] = nil
                        if equip[weapon] and not next(equip[weapon]) then equip[weapon] = nil end
                        rebuildinv()
                        return true
                    end
                end
                if not inCatalog(ctype, weapon, target) then return false end
                local cloned = clonecos(target, ctype)
                if not cloned then return false end
                equip[weapon][ctype] = cloned
            end
            rebuildinv()
            task.defer(function()
                saferep("CosmeticInventory")
                if SkinState.pickPageOpen then return end
                local fighter, item = nil, nil
                pcall(function()
                    local fctrl = reqGame(ctrls:FindFirstChild("FighterController") or ctrls.FighterController)
                    fighter = fctrl.LocalFighter or (fctrl.GetFighter and fctrl:GetFighter(lp))
                    if not fighter then return end
                    local selected = equip[weapon] and equip[weapon][ctype]
                    if type(selected) ~= "table" then fighter = nil return end
                    for _, it in pairs(fighter.Items or {}) do
                        local n = it.Name
                        pcall(function()
                            if type(it.Get) == "function" then n = it:Get("Name") or n end
                        end)
                        if n == weapon then item = it break end
                    end
                end)
                if not (fighter and item) then return end
                local selected = equip[weapon] and equip[weapon][ctype]
                pcall(function()
                    if type(item.Set) == "function" then item:Set(ctype, selected) end
                end)
                pcall(function()
                    if item.Data then item.Data[ctype] = selected end
                end)
                local wasEquipped = fighter.EquippedItem == item or item.IsEquipped == true
                -- (rebuild removed: destroy/rebuild destabilizes; Set/Data/methods suffice)
                local function refreshHotbar()
                    local hotbar = fighter.FighterInterface and fighter.FighterInterface.Hotbar
                    for _, hotbarSlot in pairs(hotbar and hotbar._hotbar_slots or {}) do
                        if hotbarSlot.ClientItem == item then
                            if hotbarSlot._Setup then pcall(hotbarSlot._Setup, hotbarSlot) end
                            if hotbarSlot.UpdateVisuals then pcall(hotbarSlot.UpdateVisuals, hotbarSlot) end
                            break
                        end
                    end
                end
                local vm = item.ViewModel
                for _, obj in ipairs({item, vm}) do
                    if obj then
                        for _, method in ipairs({
                            "_UpdateWrap", "UpdateWrap", "_UpdateCharm", "UpdateCharm",
                            "_UpdateCosmetics", "UpdateCosmetics", "_RefreshViewModel",
                            "RefreshViewModel", "UpdateViewModel"
                        }) do
                            if obj[method] then pcall(obj[method], obj) end
                        end
                    end
                end
                task.wait(0.1)
                refreshHotbar()
            end)
            return true
        end

        SkinState.Apply = applyCosmeticToWeapon
        env._applyCosmeticToWeapon = applyCosmeticToWeapon
        env._harionCoss = coss
        SkinState.Ready = true
        SkinState.InstallVersion = HUB_VERSION
        env._harionSkinSystemReady = true
        pcall(function()
            if env._installSkinViewModels then env._installSkinViewModels() end
        end)
        local _layers = {}
        for k, v in pairs(SkinState.HookLayers) do
            if v then table.insert(_layers, k) end
        end
        print("[Skin] Skin Changer ready (layers: " .. table.concat(_layers, ",") .. ", rename=" .. tostring(SkinState.RenameVerdict) .. ", fallback=" .. tostring(SkinState.FallbackVerdict) .. ")")
    end)
    if not ok then
        SkinState.LastError = err
        warn("[Skin] Skin install failed:", err)
        return false
    end
    return SkinState.Ready == true
end

