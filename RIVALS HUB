local _pickGui, _pickScanT = nil, 0
local function IsPickWeaponsOpen()
    local now = os.clock()
    if now - _pickScanT > 1 then
        _pickScanT = now
        pcall(function()
            _pickGui = nil
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pg then
                for _, d in ipairs(pg:GetDescendants()) do
                    if d.Name == "PickWeapons" and d:IsA("GuiObject") then
                        _pickGui = d
                        break
                    end
                end
            end
        end)
    end
    local ok, vis = pcall(function() return _pickGui and _pickGui.Visible end)
    return ok and vis == true
end

