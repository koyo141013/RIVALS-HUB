local function rageGetUseItem()
    if K_RAGE.useItem then return K_RAGE.useItem end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local rep = remotes and remotes:FindFirstChild("Replication")
        local fg = rep and rep:FindFirstChild("Fighter")
        local ui = fg and fg:FindFirstChild("UseItem")
        if ui and ui:IsA("RemoteEvent") then K_RAGE.useItem = ui end
    end)
    return K_RAGE.useItem
end
-- 장착 총기 + ObjectId + 플래그 (Kicia: FC.Objects에서 내 파이터 → ItemObserver:EquippedItemAsGun() → .ObjectId)
local function rageGetGun(M)
    local item = nil
    pcall(function()
        local objs = M.FC and M.FC.Objects
        if type(objs) == "table" then
            for _, fo in pairs(objs) do
                local ok, plr = pcall(function() return fo.Player end)
                if ok and plr == LocalPlayer then
                    local io = fo.ItemObserver
                    if io ~= nil then
                        if type(io.EquippedItemAsGun) == "function" then
                            local okG, g = pcall(function() return io:EquippedItemAsGun() end)
                            if okG and g ~= nil then item = g end
                        end
                        if item == nil and type(io.EquippedItem) == "function" then
                            local okE, e = pcall(function() return io:EquippedItem() end)
                            if okE and e ~= nil then item = e end
                        end
                    end
                    break
                end
            end
        end
    end)
    if item == nil then
        -- 폴백: 기존 LocalFighter 경로
        pcall(function()
            if M.FC and M.FC.LocalFighter then item = M.FC.LocalFighter.EquippedItem end
        end)
    end
    if item == nil then return nil end
    local oid = nil
    pcall(function() oid = item.ObjectId end)
    if oid == nil then pcall(function() oid = item.ObjectID end) end
    if oid == nil then pcall(function()
        if type(item.Get) == "function" then oid = item:Get("ObjectID") end
    end) end
    if oid == nil then return nil end
    local fan, ray = nil, nil
    pcall(function()
        if type(item.IsFanFired) == "function" then fan = item:IsFanFired() or nil end
    end)
    pcall(function() ray = item.IsRaycast end)
    return item, oid, fan, ray
end
local function rageStartEnum(M)
    local e = nil
    pcall(function() e = M.EL:ToEnum("StartShooting") end)
    if e == nil then pcall(function()
        if type(M.EL.encode) == "function" then e = M.EL.encode("StartShooting") end
    end) end
    return e
end

local function rageModules()
    if _rageMods ~= nil then
        return _rageMods or nil
    end
    local M = {}
    pcall(function()
        local rm = ReplicatedStorage:FindFirstChild("Modules")
        local um = rm and rm:FindFirstChild("Utility")
        if um then M.U = require(um) end
        local em = rm and rm:FindFirstChild("EnumLibrary")
        if em then M.EL = require(em) end
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        local ct = ps and ps:FindFirstChild("Controllers")
        local fm = ct and ct:FindFirstChild("FighterController")
        if fm then M.FC = require(fm) end
    end)
    -- Kicia식 발사에 필요한 건 EnumLibrary + FighterController뿐 (Utility 불필요, Spectate 대기 제거)
    if M.EL and M.FC then
        _rageMods = M
        return M
    end
    _rageMods = false
    task.delay(10, function() if _rageMods == false then _rageMods = nil end end)
    return nil
end

local function rageUpdateDeflection(FC)
    if not FC or not FC.Objects then return end
    local seen = {}
    for _, fighterObj in pairs(FC.Objects) do
        local ok, player = pcall(function() return fighterObj.Player end)
        if ok and player then
            seen[player] = true
            local alive, spectating, equipped = false, true, nil
            pcall(function()
                alive = fighterObj.Entity and fighterObj.Entity:IsAlive()
                spectating = fighterObj:Get("IsSpectating")
                equipped = fighterObj.EquippedItem
            end)
            if not alive or spectating then
                _rageDeflecting[player] = false
            else
                local vmName = nil
                pcall(function()
                    vmName = equipped and equipped.ViewModel and equipped.ViewModel.Name
                end)
                local isDeflecting = false
                if vmName == "Katana" and equipped then
                    pcall(function()
                        isDeflecting = (equipped._attack_cooldown and equipped._attack_cooldown > tick()) or false
                    end)
                end
                _rageDeflecting[player] = isDeflecting
            end
        end
    end
    for plr, _ in pairs(_rageDeflecting) do
        if not seen[plr] then _rageDeflecting[plr] = nil end
    end
end

local function rageIsEnemy(player)
    if player == LocalPlayer then return false end
    local M = _rageMods
    if M and M.SC then
        local ok, res = pcall(function()
            local duel = M.SC.CurrentDuelSubject
            local localDueler = duel and duel:GetDueler(LocalPlayer)
            local localTeam = localDueler and localDueler:Get("TeamID") or nil
            if localTeam and duel and duel.Duelers then
                for _, dueler in pairs(duel.Duelers) do
                    if dueler.Player == player then
                        return dueler:Get("TeamID") ~= localTeam
                    end
                end
                return nil
            end
            return nil
        end)
        if ok and res ~= nil then return res end
    end
    local pTeam, lTeam = nil, nil
    pcall(function() pTeam = player:GetAttribute("TeamID") end)
    pcall(function() lTeam = LocalPlayer:GetAttribute("TeamID") end)
    if pTeam and lTeam then return pTeam ~= lTeam end
    return true
end

local function rageClosestTarget()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil, nil end
    local myCam = Workspace.CurrentCamera
    if not myCam then return nil, nil, nil end
    local mousePos = UserInputService:GetMouseLocation()
    local closestPlayer, closestRoot, closestHead, closestDist = nil, nil, nil, 500
    for _, player in pairs(Players:GetPlayers()) do
        if rageIsEnemy(player) then
            local pChar = player.Character
            if pChar then
                local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                local pHead = pChar:FindFirstChild("HitboxHead") or pChar:FindFirstChild("Head")
                local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
                if pRoot and pHead and pHum and pHum.Health > 0 then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    -- 시야 내에 있는 적 우선 (FOV 체크)
                    local ok, sp, vis = pcall(function()
                        return myCam:WorldToViewportPoint(pHead.Position)
                    end)
                    if ok and vis then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                        local fovLimit = tonumber(Config.Aimbot.FOV) or 150
                        if screenDist <= fovLimit then
                            -- 거리가 가깝고 화면 중앙에 가까운 적 우선
                            local score = dist + (screenDist * 0.3)
                            if score < closestDist then
                                closestDist = score
                                closestPlayer = player
                                closestRoot = pRoot
                                closestHead = pHead
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer, closestRoot, closestHead
end

local function rageHasKnifeViewModel(targetPlayer)
    if not targetPlayer then return false end
    local viewModels = Workspace:FindFirstChild("ViewModels")
    if not viewModels then return false end
    local targetName = targetPlayer.Name
    for _, model in pairs(viewModels:GetChildren()) do
        if model:IsA("Model")
            and string.find(model.Name, targetName, 1, true)
            and string.find(model.Name, "Knife", 1, true) then
            return true
        end
    end
    return false
end

local _knifeCache = {}
local function rageHasKnifeCached(targetPlayer)
    local now = os.clock()
    local e = targetPlayer and _knifeCache[targetPlayer] or nil
    if e and now - e.t < 1 then return e.v end
    local v = rageHasKnifeViewModel(targetPlayer)
    if targetPlayer then _knifeCache[targetPlayer] = { v = v, t = now } end
    return v
end

local function rageAutoEquip(M)
    if not M or not M.FC then return end
    -- 켜진 슬롯만 지정 순서대로 순환 (탄 없음이면 즉시 다음)
    local order = {}
    local seen = {}
    local src = (type(S.rageSlotOrder) == "table" and #S.rageSlotOrder > 0) and S.rageSlotOrder or RAGE_ROT.order
    for _, name in ipairs(src) do
        if (name == "Primary" or name == "Secondary" or name == "Melee") and not seen[name] then
            seen[name] = true
            local en = S.rageSlotEnabled and S.rageSlotEnabled[name]
            if en ~= false then table.insert(order, name) end
        end
    end
    if #order == 0 then return end
    local now = os.clock()
    local ammoEmpty = false
    pcall(function()
        local item = rageGetGun(M)
        if item and type(item.GetAmmo) == "function" then
            local a = item:GetAmmo()
            if type(a) == "number" and a <= 0 then ammoEmpty = true end
        end
    end)
    if not ammoEmpty and now - RAGE_ROT.last < 4 then return end
    RAGE_ROT.idx = (RAGE_ROT.idx % #order) + 1
    RAGE_ROT.last = now
    local slot = _rageSlots[order[RAGE_ROT.idx]] or 3
    pcall(function()
        local lf = M.FC.LocalFighter
        if lf and type(lf.EquipItem) == "function" then lf:EquipItem(slot) end
    end)
end

task.spawn(function()
    while not getgenv().RivalsHubDead do
        task.wait(1)
        if S.ragebotOn then
            local M = rageModules()
            if M then rageAutoEquip(M) end
        end
    end
end)

