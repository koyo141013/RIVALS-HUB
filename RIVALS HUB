local function _trackPlayer(plr)
    if plr == LocalPlayer then return end
    local function hookChar(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and not _tracked[hum] then
            _tracked[hum] = true
            table.insert(_killConnections, hum.Died:Connect(_onEnemyDied))
            table.insert(_killConnections, hum.HealthChanged:Connect(function(hp) if hp <= 0 then _onEnemyDied() end end))
        end
    end
    if plr.Character then hookChar(plr.Character) end
    table.insert(_killConnections, plr.CharacterAdded:Connect(hookChar))
end
