local DEFAULT_WALK = 16

local function ApplyWalk()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.WalkSpeed = Config.Walk.Enabled and Config.Walk.Speed or DEFAULT_WALK
        end)
    end
end

local function SetWalk(on)
    Config.Walk.Enabled = on
    ApplyWalk()
end

local function WalkStep(dt)
    if not Config.Walk.Enabled then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    pcall(function() hum.WalkSpeed = math.max(Config.Walk.Speed, DEFAULT_WALK) end)
    local md = hum.MoveDirection
    if md.Magnitude > 0.01 and Config.Walk.Speed > DEFAULT_WALK then
        dt = (typeof(dt) == "number" and dt > 0 and dt < 0.2) and dt or (1 / 60)
        pcall(function()
            hrp.CFrame = hrp.CFrame + md.Unit * (Config.Walk.Speed - DEFAULT_WALK) * dt
        end)
    end
end

