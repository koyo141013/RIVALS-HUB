local function HideESP(o)
    for _, d in pairs(o) do d.Visible = false end
end

local function UpdateESPPlayer(player, viewportSize)
    local o = GetESP(player)
    if not Config.ESP.Enabled or player == LocalPlayer then HideESP(o) return end
    if Config.ESP.TeamCheck and IsTeammate(player) then HideESP(o) return end
    local char = GetCharacter(player)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    if not char or not hum or hum.Health <= 0 or not hrp or not head then HideESP(o) return end
    local dist3d = (Camera.CFrame.Position - hrp.Position).Magnitude
    if dist3d > Config.ESP.MaxDistance then HideESP(o) return end

    local top3d = head.Position + Vector3.new(0, 0.6, 0)
    local bot3d = hrp.Position - Vector3.new(0, 3, 0)
    local top, topVis = Camera:WorldToViewportPoint(top3d)
    local bot, botVis = Camera:WorldToViewportPoint(bot3d)
    if not topVis and not botVis then HideESP(o) return end

    local h = math.abs(bot.Y - top.Y)
    local w = h * 0.6
    local x = bot.X - w / 2
    local y = top.Y

    local teammate = IsTeammate(player)
    local baseColor = teammate and Config.ESP.TeamColor or Config.ESP.BoxColor
    local obscured = false
    if LocalPlayer.Character then
        obscured = HasWallBetween(Camera.CFrame.Position, hrp.Position, { LocalPlayer.Character, char, Camera })
    end
    local color = obscured and Config.ESP.HiddenColor or baseColor

    if Config.ESP.Boxes then
        o.box.Visible = true; o.boxOutline.Visible = true
        o.box.Size = Vector2.new(w, h); o.box.Position = Vector2.new(x, y); o.box.Color = color
        o.boxOutline.Size = Vector2.new(w, h); o.boxOutline.Position = Vector2.new(x, y)
    else o.box.Visible = false; o.boxOutline.Visible = false end

    if Config.ESP.HealthBar then
        local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local bw = 4
        o.hpBack.Visible = true
        o.hpBack.Size = Vector2.new(bw, h); o.hpBack.Position = Vector2.new(x - bw - 2, y)
        o.hpFront.Visible = true
        o.hpFront.Size = Vector2.new(bw - 2, h * frac)
        o.hpFront.Position = Vector2.new(x - bw - 1, y + h * (1 - frac))
        o.hpFront.Color = Color3.fromHSV(frac * 0.33, 1, 1)
    else o.hpBack.Visible = false; o.hpFront.Visible = false end

    if Config.ESP.Names then
        o.name.Visible = true
        o.name.Text = (player.DisplayName ~= player.Name) and (player.DisplayName .. " (@" .. player.Name .. ")") or player.Name
        o.name.Position = Vector2.new(bot.X, y - 16)
        o.name.Color = color
    else o.name.Visible = false end

    if Config.ESP.Distance then
        o.dist.Visible = true
        o.dist.Text = string.format("%dm", math.floor(dist3d))
        o.dist.Position = Vector2.new(bot.X, bot.Y + 2)
    else o.dist.Visible = false end

    if Config.ESP.Snaplines then
        o.line.Visible = true
        o.line.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
        o.line.To = Vector2.new(bot.X, bot.Y)
        o.line.Color = color
    else o.line.Visible = false end
end

