local function NewDraw(class, props)
    local okD, d = pcall(function() return Drawing.new(class) end)
    if not okD or d == nil then
        -- Drawing 미지원: 전체 청크 사망 방지용 더미 (읽기 nil, 쓰기 무시, Remove 무연산)
        local dummy = {}
        setmetatable(dummy, {
            __index = function(_, k)
                if k == "Remove" then return function() end end
                return nil
            end,
            __newindex = function() end,
        })
        return dummy
    end
    for k, v in pairs(props) do
        local ok = pcall(function() d[k] = v end)
        if not ok then pcall(setrenderproperty, d, k, v) end
    end
    return d
end

