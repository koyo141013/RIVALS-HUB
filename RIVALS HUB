    local function getCosmeticImage(entry)
        if type(entry) ~= "table" then return nil end
        for _, k in ipairs({"Image", "ImageId", "Icon", "Thumbnail", "PreviewImage", "AssetId"}) do
            local v = entry[k]
            if type(v) == "string" and v ~= "" then
                if tonumber(v) then return "rbxassetid://" .. v end
                if string.find(v, "rbxasset") then return v end
            elseif type(v) == "number" and v > 0 then
                return "rbxassetid://" .. tostring(v)
            end
        end
        return nil
    end

