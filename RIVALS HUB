    { v = "V0.9.4d", text = T("언로드/재실행 튕김 수정 — 충돌 복구를 CanCollide=false(정상 기본값)로 변경 + 속도 0. true로 두면 지면 겹침 시 위로 발사됨.", "Unload fling fix — restore CanCollide=false + zero velocity.") },
    { v = "V0.9.4c", text = T("탭 정리 — Combat(레이지/트리거/무기)·Movement 탭 신설, Device Spoof는 Spoof로. Main은 에임봇/ESP만.", "Tab reorg — new Combat and Movement tabs, Device Spoof moved to Spoof.") },
    { v = "V0.9.4b", text = T("트리거봇 벽 체크 — 가려진 적에게는 발사 안 함. 벽 체크 토글 추가.", "Triggerbot wall check — no fire at occluded enemies.") },
    { v = "V0.9.4a", text = T("레이지 명중률 — HitboxHead 우선 + 중심 정조준 + 리졸버 차단 시 가공 스킵. 사일런트 FOV 메인루프 구동 + 상태에 FOV 표시.", "Rage accuracy via HitboxHead + center aim. Silent FOV driven by main loop.") },
    { v = "V0.9.4", text = T("에임봇 팀 체크 — TeamID 우선 판정으로 적만 조준. 사일런트에도 팀 체크 추가 + 에임봇 팀체크 토글.", "Aimbot team check — TeamID-based enemies-only targeting, silent aim included.") },
    { v = "V0.9.3e", text = T("스카이박스 72종 — Kicia 전 프리셋 이식(Blizzard~Dawn). 기존 6종 포함, 중복 없음.", "72 skyboxes — all Kicia presets ported.") },
    { v = "V0.9.3d", text = T("연사 비율 상한 100→1000%. 1000%로 올리면 쿨다운 1/10로 풀오토 가속.", "Fire Rate cap 100 to 1000 percent for faster full-auto.") },
    { v = "V0.9.3c", text = T("언로드 재수정 — DisconnectAll pcall 처리 + Obsidian GUI 직접 제거 폴백. 중간 단계 실패해도 메뉴까지 확실히 닫힘.", "Unload fix v2 — pcall DisconnectAll + direct Obsidian GUI destroy fallback.") },
    { v = "V0.9.3b", text = T("Weapons UI 방탄화 — 토글/슬라이더 개별 pcall + 실패 시 콘솔 경고 + 생성 개수 출력.", "Weapons UI hardening — per-control pcall with console warnings.") },
    { v = "V0.9.3a", text = T("구 Fast Shot/No Spread 토글 제거 (Weapons 분류로 통합). 잔류값 강제 OFF.", "Removed legacy Fast Shot/No Spread toggles (merged into Weapons). Residual flags forced OFF.") },
    { v = "V0.9.3", text = T("Weapons 분류 추가(1n2ee 이식) — 노스프레드/패스트슛/패스트프로젝타일/풀오토/항상백스탭+연사비율. 원본 로직 그대로, 언로드 시 원복.", "Weapons tab ported from 1n2ee — nospread/fastshoot/projectile/fullauto/backstab + rate. Restored on unload.") },
    { v = "V0.9.2g", text = T("트리거봇 Main 탭 내 별도 분류로 이동 (탭 분리 취소).", "TriggerBot moved into its own groupbox inside Main tab.") },
    { v = "V0.9.2f", text = T("트리거봇 별도 탭 분리 — Trigger 탭에 토글+5종 옵션 이동. 저장 ID 그대로라 기존 설정 유지.", "TriggerBot own tab — moved toggle + 5 options. Saved settings kept.") },
    { v = "V0.9.2e", text = T("트리거봇 5종 옵션 — 반응시간/반응오차/망각시간/발사딜레이/최대거리. 사진 스펙 그대로.", "Triggerbot 5 options — reaction/offset/forget/shoot-delay/max-distance.") },
    { v = "V0.9.2d", text = T("순환 순서 지정 — 순서 1/2/3 드롭다운으로 회전 순서 변경 가능 (중복은 자동 제거).", "Custom cycle order — Order 1/2/3 dropdowns (duplicates auto-removed).") },
    { v = "V0.9.2c", text = T("무기 순환 — Weapon Slot 단일 선택→3종 토글. 켜진 슬롯을 Primary→Secondary→Melee로 순환 장착, 탄 없음이면 즉시 다음.", "Weapon cycle — 3 slot toggles, rotates Primary to Melee, swaps early when empty.") },
    { v = "V0.9.2b", text = T("무기 선택 중 일시정지 — PickWeapons 실시간 감지(캐시+1초 재탐색). 선택창 열리면 레이지/트리거/회피 전부 정지.", "Pause while picking weapons — realtime PickWeapons detection. Rage/trigger/evasion halt.") },
    { v = "V0.9.2a", text = T("레이지 무조건 발사 — 메뉴 닫힘 상태에서 타깃 없이도 Fire Rate 간격 발사. 타깃 있으면 Controller가 조준 보정.", "Rage always fires when menu closed, target or not. Controller corrects aim when target held.") },
    { v = "V0.9.2", text = T("레이지봇 자동 발사 — Controller 타깃 유지 시 Fire Rate 간격으로 자동 클릭. 리졸버 ON이면 방패/카타나 정면 제외.", "Ragebot autofire — auto-clicks at Fire Rate while Controller holds target. Resolver skips shields.") },
    { v = "V0.9.1h", text = T("레이지봇 AntiEnhancement식으로 교체 — Controller desync 엔진 기동(Kicia 직접발사 봉인). 시작 성공/모듈대기 알림 + 팀전 kill 판정. 둘 동시 실행 금지.", "Ragebot switched to AntiEnhancement Controller desync engine. Never run both scripts together.") },
    { v = "V0.9.1g", text = T("레이지 총기 탐색 수정 — 원본처럼 FC.Objects→내 파이터→ItemObserver:EquippedItemAsGun(). 켠 뒤 3초 무발사면 막힌 단계 알림.", "Rage gun lookup fix — FC.Objects to ItemObserver like original. Notify blocked stage if no fire in 3s.") },
    { v = "V0.9.1f", text = T("레지스터 초과 수정 — 청크 local 204→171개로 축소(데이터 테이블 패킹 + UI 구간 스코핑). 동작 변경 없음.", "Register overflow fix — chunk locals 204 to 171 via table packing and UI scoping. No behavior change.") },
    { v = "V0.9.1e", text = T("레이지봇 Kicia 이식 — jD gun Plan 그대로(desync+상수 페이로드+HitboxHead+raycast 플래그). 카메라 CFrame 계산 제거(원본에 없음). 단계 진단 Stage 표시. 나이프는 클릭 폴백.", "Ragebot Kicia port — desync + const payload + HitboxHead + raycast flag, no camera frames. Stage diagnosis.") },
    { v = "V0.9.1d", text = T("레이지 무반응 수정 — 메뉴 닫을 때 ON이 옛값으로 덮어씌워지던 버그 제거(MenuOpen 게이트로 이미 일시정지됨). Targets/Fired 상태 라벨 추가.", "Rage unresponsive fix — menu close no longer wipes ON state. Targets/Fired status label added.") },
    { v = "V0.9.1c", text = T("사일런트 진단+내성 — 후킹 영속 재시도(5초), enum 문자열 폴백 매칭, Seen/Redirected 상태 라벨, 후킹됨/대기중 알림, Drawing 부재 경고.", "Silent diagnosis — persistent rehook, enum string fallback, Seen/Redirected status label, hooked/waiting notify.") },
    { v = "V0.9.1b", text = T("레이지봇 초기식으로 교체 — 직접발사/desync 엔진 비활성, 스냅 조준+클릭 발사만. 클릭/이동 함수 공용 확보. Controller 기동 봉인.", "Ragebot reverted to original — snap aim + click fire only, direct-fire/desync engine off.") },
    { v = "V0.9.1a", text = T("트리거봇 수정(클릭함수 확보+부재 진단+팀원 오발 방지) + 레이지 박스 순서 정리(사진 항목을 봇 바로 아래로) + 언어 파일 영속(리조인 유지) + 플레이어 LocaleId 우선 감지 + 로드 알림에 적용 언어 표시.", "Triggerbot fix (click-fn resolve + missing diagnosis + no team fire) + Rage box reorder + language file persist + Player.LocaleId priority + applied language in load notify.") },
    { v = "V0.9.1", text = T("언로드 수정 — 버튼 형식 오류(무반응) + 사일런트 FOV 잔상 + 후킹 미원복 해결. 언로드 시 전 후킹 원복 + 전 도형 제거 + 완료 알림.", "Unload fix — dead button format + leftover silent FOV + unrestored hooks. Unload now restores all hooks, removes all drawings, and notifies.") },
    { v = "V0.0.9.14", text = T("랭크 표시 수정 — Kicia RankTracker 이식(DisplayELO + SeasonLibrary → 랭크명). 기존 leaderstats/Rank 경로는 존재하지 않아 항상 숨겨졌음. 윈스트릭 속성명 폴백 추가.", "Rank ESP fix — ported Kicia RankTracker (DisplayELO + SeasonLibrary rank name). Old leaderstats/Rank path never existed so it stayed hidden. Winstreak attribute fallbacks added.") },
    { v = "V0.0.9.13", text = T("언어 전체 적용 — 전 메뉴 한/영 전환 + 감지 강화(cloneref/정규화) + 콘솔 locale 출력 + UI Settings 수동 선택(자동/한국어/English).", "Full language support — entire menu KR/EN + hardened detection (cloneref/normalize) + console locale print + manual override in UI Settings.") },
    { v = "V0.0.9.12", text = "사일런트 FOV 독립 렌더러(마우스 중심) + ESP Kicia 풀옵션(Filled/Ammo/Head모양/Tracer/Chams/Skeleton) + 체험언어 한/영 자동 전환." },
    { v = "V0.0.9.11", text = "Harion 원본 활성화 — 비활성 블록 해제, V0.0.9.2 엔진은 비활성. 헤드/몸통 + 카타나 제외." },
    { v = "V0.0.9.10", text = "사일런트 원본 방식으로 교체 — Hitbox 우선 탐색 + 카타나 제외 옵션. 헤드/몸통 지원." },
    { v = "V0.0.9.9", text = "Minimal 모드 — getgenv().RivalsMinimal = true 후 실행하면 후킹/루프 없이 에임봇+ESP만 동작. 원인 분리 확정용." },
    { v = "V0.0.9.8", text = "후킹 복원 레지스트리 — 전 후킹 지점 원본 저장, Restore Hooks 토글로 전체 원복. 외부 충돌 판별 확정용." },
    { v = "V0.0.9.7", text = "후킹 재진입 가드 + Input Hooks 원복 토글. 스택에 지목된 ClientItem 후킹을 런타임에 완전히 걷어낼 수 있음." },
    { v = "V0.0.9.6", text = "사일런트 Harion 방식으로 교체 — 타겟 선정 후 헤드/몸통/둘다(조준선 최근접) 해석. 팀 체크 포함." },
    { v = "V0.0.9.5", text = "발사 부하 분산 — 연사 하한 0.03초 고정, 나이프 판정 1초 캐시(워크스페이스 전체 스캔 제거)." },
    { v = "V0.0.9.3", text = "발사 최적화 — 연사 하한 0.03초, 나이프 판정 1초 캐시. 매 프레임 무거운 스캔 제거로 프레임 드랍 해소." },
    { v = "V0.0.9.4", text = "Safe Mode 추가 — 전 기능 Kill (원인 분리용). UY/Dj류 게임 내부 재귀는 스크립트 콜스택에 없어 외부 요인 판별 필요." },
    { v = "V0.0.9.3", text = "참조 안정성 수정 — 병합/프록시 결과를 캐시해 동일 입력에 동일 테이블 반환. 게임의 동일성 검사 무한 재시도(C스택) 해소." },
    { v = "V0.0.9.2", text = "제공 코드로 교체 — 레이지봇(디싱크+직접발사+디플렉트회피+슬롯자동장착) 및 사일런트 에임(Entity 타겟+레이캐스트 리다이렉트+중앙 FOV). 헤드/몸통/둘다 지원." },
    { v = "V0.0.9.1", text = "사일런트 에임 추가 — UseItem.FireServer 카메라데이터 조작 (카메라 고정 조준). 토글/FOV/부위 설정. kicia 프레임워크 본체는 제외." },
    { v = "V0.0.9.0", text = "kicia 리졸버/회피기동 — 각도 기반 방패/카타나 판정 토글 + Evasion Random/Translocate 모드 + Online 오프라인 표시. 프레임워크 의존 부분(리졸버 코어/투사체차단/온라인서버)은 제외." },
    { v = "V0.0.8.0", text = "언로드 수정(전 루프 정지 + 설정 초기화) + 레이지봇 Stability/ShootFrames 슬라이더 + 커스텀 스카이박스 추가. kicia 리졸버/회피/온라인 모듈은 디컴파일 프레임워크라 제외." },
    { v = "V0.0.7.1", text = "창 닫힘 마우스 복구 — 커서 표시 상태까지 저장/복원, Obsidian 실제 표시와 0.25초 동기화로 어긋남 자동 복구." },
    { v = "V0.0.7.0", text = "스킨체인저 제거 + ESP 확장(코너박스/체력숫자/착용무기/랭크/윈스트릭/디플렉트/챔스/스켈레톤/헤드도트/팀원/트레이서) + World 탭 스카이박스 6종." },
    { v = "V0.0.6.3", text = "1n2ee require 방식 적용 — 모든 게임 모듈 require 시 스레드 ID 2로 낮춰서 게임과 동일한 테이블 참조. VM 독립 재시도 루프 추가." },
    { v = "V0.0.6.2", text = "Signal 폭풍 수정 — 복제 테이블의 메타테이블 공유를 제거. 공유된 __newindex가 게임 저장소로 쓰기를 전달하면서 이벤트 연쇄(Dj 재귀)를 일으켰음." },
    { v = "V0.0.6.1", text = "PickWeapons 보호 — 선택창이 열려 있는 동안 스킨 경로 전부 우회, 닫히면 장착 스킨 자동 재적용. 선택창 재귀 충돌 해소." },
    { v = "V0.0.6.0", text = "스킨 안전 구조 전환 — 클래스 교체/리빌드/WeaponInventory 전송 제거(무기 증발 원인). 주입 후 순정 생성으로 위임. Data Hooks 기본 OFF." },
    { v = "V0.0.5.9", text = "가상 뷰모델 등록 — 적용 시 카탈로그 스킨용 ViewModels 항목 자동 생성(기본 무기 복제). 뷰모델 해석 실패 원천 해소." },
    { v = "V0.0.5.8", text = "오토 로드아웃 스팸 방지 — 변경 시에만 1회 전송(0.5초 무한 전송 제거). PickWeapons 화면 진입 시 C스택 충돌 완화." },
    { v = "V0.0.5.7", text = "무기 사라짐 수정 — VM 후킹이 install 내부 지역변수 equip을 참조해 nil 에러로 뷰모델 생성이 전부 실패하던 버그. SkinState.equip 직접 참조로 교체." },
    { v = "V0.0.5.6", text = "VM 훅 킬스위치 — Skins 탭에서 뷰모델 생성 후킹 ON/OFF. PickWeapons 진입 시 C스택 에러 나면 OFF로 원인 분리." },
    { v = "V0.0.5.5", text = "뷰모델 리빌드 연결 — 적용 시 현재 뷰모델을 스킨 버전으로 즉시 재생성(실패 시 원본 복구). Replicate OFF 유지." },
    { v = "V0.0.5.4", text = "스킨 액션 로그 + 서버 전송 토글 — 모든 스킨 동작을 시간 기록으로 남기고 Copy Skin Log로 복사. Replicate 기본 OFF(로컬만)로 로비 신호 차단." },
